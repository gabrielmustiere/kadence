# APP_ENV est fixé par l'image (prod pour app, dev pour seed) : ne pas le définir ici.

# Générer avec : openssl rand -hex 32
APP_SECRET=CHANGEME
DEFAULT_URI=https://kadence.mustiere.fr

DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/kadence.db"

# L'application n'envoie ni e-mail ni message asynchrone : aucun worker déployé.
MESSENGER_TRANSPORT_DSN=sync://
MAILER_DSN=null://null

# Caddy hôte -> docker-proxy -> conteneur : FrankenPHP voit l'IP de la gateway du réseau
# Compose (plage privée). Sans ça, X-Forwarded-Proto est ignoré : cookies non `secure`
# et redirection après connexion en http.
SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host
