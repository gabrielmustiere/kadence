{% extends 'base.html.twig' %}

{% block title %}Modifier {{ lot.title }} · Kadence{% endblock %}

{# Restored from the cache, the form would come back with the tag filter of the visit left, under a fresh team. #}
{% block turbo_meta %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block body %}
    <twig:PageHeader title="Modifier « {{ lot.title }} »" :eyebrow="lot.project.title" :back="back_path" backLabel="Retour">
        <twig:block name="description">
            <p class="mt-2.5 max-w-3xl text-[15px] leading-relaxed text-body">
                {{ lot.subLot ? 'Sous-lot de « ' ~ lot.parent.title ~ ' »' : 'Lot' }} du projet « {{ lot.project.title }} ».
                {% if not lot.leaf %}
                    Son estimation est la somme de ses sous-lots.
                {% endif %}
            </p>
            {% if consumed_quarters > 0 %}
                <p class="mt-3 flex max-w-3xl gap-2.5 rounded-xl border border-default bg-surface px-4 py-3 text-sm leading-relaxed text-body shadow-xs" data-test="lot-consumed">
                    <twig:ux:icon name="tabler:clock-hour-4" class="mt-0.5 size-4 shrink-0 text-body-subtle" aria-hidden="true"/>
                    <span>
                        {% if lot.initialEstimateDays is not null %}Estimation initiale : <strong class="text-heading">{{ lot.initialEstimateDays }} j</strong>. {% endif %}
                        {{ consumed_quarters|days }} déjà saisis : une révision de l'estimation ne peut pas descendre sous {{ minimum_estimate_days }} j.
                    </span>
                </p>
            {% endif %}
        </twig:block>
    </twig:PageHeader>
    <twig:Card>
        <twig:LotForm :form="form" :lot="lot" :cancelPath="back_path"/>
    </twig:Card>
{% endblock %}
