<div class="pointer-events-none fixed inset-0 z-[60] flex items-end px-4 py-6 sm:items-start sm:p-6 sm:pt-20" data-controller="flash-stack" data-action="app:flash@window->flash-stack#push">
    <div class="flex w-full flex-col items-center space-y-3 sm:items-end" data-flash-stack-target="list">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                {{ include('common/_flash.html.twig') }}
            {% endfor %}
        {% endfor %}
    </div>
    {% for type in ['success', 'error', 'warning', 'info'] %}
        <template data-flash-stack-target="template" data-type="{{ type }}">{{ include('common/_flash.html.twig', {message: '', alert: false}) }}</template>
    {% endfor %}
</div>
