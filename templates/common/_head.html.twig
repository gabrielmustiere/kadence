{# Set before the first paint, so that a dark page never flashes light. #}
<script>
    try {
        const theme = localStorage.getItem('kadence-theme');
        if (theme === 'dark' || (theme === null && matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    } catch {}
</script>
