{% extends 'base.html.twig' %}

{% set window = roadmap.window %}

{% block title %}Roadmap · Kadence{% endblock %}

{% block body %}
    <div data-controller="roadmap" data-roadmap-center-value="{{ (roadmap.todayPosition ?? window.position(window.anchor.monday))|number_format(4, '.', '') }}">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="font-display text-2xl font-bold tracking-tight text-heading sm:text-3xl">Roadmap</h1>
            <p class="mt-1 text-sm text-body">La chronologie de chaque projet : ce qui a été saisi, puis ce qui reste, réparti sur la capacité de l'équipe.</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
        <nav class="flex gap-2" aria-label="Période affichée">
            <twig:Button as="a" size="sm" variant="outline" href="{{ path('app_roadmap_week', {week: window.previous.iso}) }}" data-test="roadmap-previous">
                <twig:ux:icon name="tabler:chevron-left" class="size-4 me-1"/>
                4 semaines
            </twig:Button>
            <twig:Button as="a" size="sm" variant="{{ window.anchor.equals(current_week) ? 'brand' : 'outline' }}" href="{{ path('app_roadmap') }}" :aria-current="window.anchor.equals(current_week) ? 'page' : false" data-test="roadmap-today">Aujourd'hui</twig:Button>
            <twig:Button as="a" size="sm" variant="outline" href="{{ path('app_roadmap_week', {week: window.next.iso}) }}" data-test="roadmap-next">
                4 semaines
                <twig:ux:icon name="tabler:chevron-right" class="size-4 ms-1"/>
            </twig:Button>
        </nav>
        {{ include('roadmap/_zoom.html.twig') }}
        </div>
    </div>

    {{ include('roadmap/_legend.html.twig') }}

    {% if roadmap.projects is empty %}
        <twig:Card data-test="roadmap-empty">
            <p class="text-body">Aucun projet pour l'instant.</p>
        </twig:Card>
    {% else %}
        {% embed 'roadmap/_frieze.html.twig' %}
            {% block rows %}
                {% for project in roadmap.projects %}
                    <div class="relative border-t border-default" data-test="roadmap-project" data-title="{{ project.title }}">
                        <details class="group" data-roadmap-target="project" data-project-id="{{ project.project.id }}" data-action="toggle->roadmap#remember">
                            <summary class="grid cursor-pointer list-none grid-cols-[20rem_1fr] hover:bg-neutral-secondary-soft [&::-webkit-details-marker]:hidden">
                                <div class="sticky left-0 z-10 bg-neutral-primary py-3 ps-4 pe-11 group-hover:bg-neutral-secondary-soft">
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        <twig:ux:icon name="tabler:chevron-right" class="size-4 shrink-0 text-body transition-transform group-open:rotate-90"/>
                                        <span class="font-semibold text-heading">{{ project.title }}</span>
                                        {% for signal in project.signals %}
                                            <twig:Badge variant="{{ signal.variant }}" data-test="signal-{{ signal.value }}">{{ signal.label }}</twig:Badge>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="roadmap-track relative min-h-12">
                                    {{ include('roadmap/_today.html.twig') }}
                                    {% if project.span %}
                                        {{ include('roadmap/_bar.html.twig', {row: project, bar: project.span, kind: 'span', class: 'h-3 rounded-full bg-brand-medium', test: 'roadmap-bar-span'}) }}
                                    {% endif %}
                                </div>
                            </summary>
                            {% for row in project.children %}
                                {{ include('roadmap/_row.html.twig', {row: row, depth: 1}) }}
                            {% endfor %}
                        </details>
                        {# Laid over the summary rather than inside it: browsers expose a summary as a button, which may not hold a link. #}
                        <div class="pointer-events-none absolute inset-x-0 top-0">
                            <div class="sticky left-0 z-20 w-80">
                                <a href="{{ path('app_roadmap_project', {id: project.project.id, roadmap: roadmap.window.anchor.iso}) }}" class="pointer-events-auto absolute end-3 top-3 grid size-6 place-items-center rounded-sm text-body hover:text-heading focus:outline-none focus:ring-2 focus:ring-brand-medium" title="Ouvrir la fiche" aria-label="Ouvrir la fiche de {{ project.title }}" data-test="roadmap-project-open">
                                    <twig:ux:icon name="tabler:file-description" class="size-4"/>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    {% endif %}
    </div>
{% endblock %}
