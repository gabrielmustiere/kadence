{#
    A lot or a leaf of the roadmap, and the sub-lots of a split lot. Expects `row`, `roadmap` and `depth`; `links` set to
    false keeps the title of a leaf from linking to its edition.
#}
{% set lot = row.lot %}
{% set recap = row.leaf ? 'roadmap-recap-lot-' ~ lot.id : null %}
<div class="grid grid-cols-[20rem_1fr] group/row border-t border-default-subtle transition-colors hover:bg-neutral-secondary-soft" data-test="{{ row.leaf ? 'roadmap-leaf' : 'roadmap-lot' }}" data-title="{{ row.title }}">
    <div class="sticky left-0 z-10 border-e border-default-subtle bg-surface transition-colors group-hover/row:bg-neutral-secondary-soft px-4 py-2.5 {{ depth > 1 ? 'ps-14' : 'ps-9' }}">
        <div class="flex flex-wrap items-center gap-1.5">
            {% if row.leaf and (links ?? true) and is_granted('LOT_EDIT', lot) %}
                <a href="{{ path('app_lot_edit', {id: lot.id, roadmap: roadmap.window.anchor.iso}) }}" class="text-[13px] font-medium text-heading decoration-default-strong underline-offset-4 hover:underline" aria-describedby="{{ recap }}" data-roadmap-tooltip="{{ recap }}" data-test="roadmap-leaf-link">{{ row.title }}</a>
            {% elseif row.leaf %}
                <button type="button" tabindex="0" class="cursor-help rounded-xs text-left text-[13px] font-medium text-heading" aria-describedby="{{ recap }}" data-roadmap-tooltip="{{ recap }}" data-test="roadmap-leaf-title">{{ row.title }}</button>
            {% else %}
                <span class="text-[13px] font-semibold text-heading">{{ row.title }}</span>
            {% endif %}
            {% for signal in row.signals %}
                <twig:Badge variant="{{ signal.variant }}" data-test="signal-{{ signal.value }}">{{ signal.label }}{% if signal is same as(constant('App\\Enum\\Type\\RoadmapSignal::Overrun')) %} +{{ row.overrunPercent }} %{% endif %}</twig:Badge>
            {% endfor %}
        </div>
    </div>
    <div class="roadmap-track relative min-h-12">
        {{ include('roadmap/_today.html.twig') }}
        {% if row.leaf %}
            {{ include('roadmap/_recap.html.twig') }}
            {% if row.realized %}{{ include('roadmap/_bar.html.twig', {bar: row.realized, kind: 'realized', class: 'h-3.5 rounded-[4px] bg-brand', test: 'roadmap-bar-realized'}) }}{% endif %}
            {% if row.overrun %}{{ include('roadmap/_bar.html.twig', {bar: row.overrun, kind: 'overrun', class: 'h-3.5 rounded-[4px] bg-danger', test: 'roadmap-bar-overrun'}) }}{% endif %}
            {% if row.future %}{{ include('roadmap/_bar.html.twig', {bar: row.future, kind: 'future', class: 'h-3.5 rounded-[4px] border border-dashed border-brand bg-brand-softer hatch-brand', test: 'roadmap-bar-future'}) }}{% endif %}
        {% elseif row.span %}
            {{ include('roadmap/_bar.html.twig', {bar: row.span, kind: 'span', class: 'h-2 rounded-full bg-brand-medium', test: 'roadmap-bar-span'}) }}
        {% endif %}
    </div>
</div>
{% for child in row.children %}
    {{ include('roadmap/_row.html.twig', {row: child, depth: depth + 1}) }}
{% endfor %}
