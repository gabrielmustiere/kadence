{#
    Every run of a page, from the latest to the earliest, under the month of its last day. Expects `page`; on the page
    of a person, `with_team` false leaves out who entered what, `with_project` true heads each leaf with its project and
    `empty_message` replaces the message of a project without time entered.
#}
{% if page.timeline is empty %}
    <twig:EmptyState icon="tabler:clock" data-test="timeline-empty">
        {{ empty_message ?? "Personne n'a encore saisi de temps sur ce projet." }}
    </twig:EmptyState>
{% else %}
    <div class="space-y-6" data-test="timeline">
        {% for month in page.timeline %}
            <section class="grid grid-cols-1 gap-3 lg:grid-cols-[9rem_minmax(0,1fr)] lg:gap-6" data-test="timeline-month">
                <h3 class="eyebrow pt-3.5 text-body-subtle lg:sticky lg:top-20 lg:self-start" data-test="timeline-month-label">{{ month.label }}</h3>
                <ol class="max-w-4xl divide-y divide-default-subtle overflow-hidden rounded-card border border-default bg-surface shadow-card">
                    {% for entry in month.entries %}
                        {% set run = entry.run %}
                        <li class="relative px-5 py-3.5 ps-10 text-sm" data-test="timeline-entry" data-leaf="{{ entry.leafPath }}">
                            <span class="absolute start-4 top-[1.2rem] size-2.5 rounded-full ring-4 {{ entry.beyondEstimate ? 'bg-danger ring-danger-soft' : 'bg-brand ring-brand-softer' }}" aria-hidden="true"></span>
                            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                                <p class="font-medium text-heading" data-test="timeline-entry-leaf">
                                    {%- if with_project ?? false -%}
                                        <a href="{{ path('app_roadmap_project', {id: entry.leaf.project.id}) }}" class="underline decoration-default-medium underline-offset-4 hover:decoration-default-strong" data-test="person-project-link">{{ entry.leaf.project.title }}</a> ·{{ ' ' }}
                                    {%- endif -%}
                                    {{ entry.leafPath -}}
                                </p>
                                <p class="whitespace-nowrap text-xs tabular-nums text-body" data-test="timeline-entry-period">{{ run.from|weekday }} {{ run.from|date('d/m/Y') }} → {{ run.to|weekday }} {{ run.to|date('d/m/Y') }}</p>
                            </div>
                            <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-body">
                                <span><span class="font-medium tabular-nums text-heading" data-test="timeline-entry-entered">{{ run.quarters|days }}</span> saisis</span>
                                <span><span class="font-medium tabular-nums text-heading" data-test="timeline-entry-days">{{ run.dayCount }}</span> {{ run.dayCount > 1 ? 'jours' : 'jour' }} avec saisie</span>
                                {% if entry.beyondEstimate %}
                                    <twig:Badge variant="danger" data-test="timeline-entry-overrun">au-delà de l'estimation</twig:Badge>
                                {% endif %}
                            </div>
                            {% if with_team ?? true %}
                                <div class="mt-2.5 max-w-md rounded-lg bg-neutral-secondary-soft px-3 py-2 text-xs">
                                    {{ include('roadmap/_team.html.twig', {lines: run.team, entered: true, links: true}) }}
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </section>
        {% endfor %}
    </div>
{% endif %}
