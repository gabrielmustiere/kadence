{#
    The legend of a frieze and the days it shows. Expects `roadmap`.
#}
<div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-body" data-test="roadmap-legend">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-sm bg-brand"></span>Saisi</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-sm bg-danger"></span>Saisi au-delà de l'estimation</span>
    <span class="inline-flex items-center gap-1.5" data-test="roadmap-legend-gap"><span class="inline-flex h-3 w-6 gap-1"><span class="flex-1 rounded-sm bg-brand"></span><span class="flex-1 rounded-sm bg-brand"></span></span>Jour ouvré sans saisie</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-6 rounded-sm border border-dashed border-brand bg-brand-soft"></span>Restant, calculé</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2 w-6 rounded-full bg-brand-medium"></span>Lot ou projet</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-3 w-px bg-danger"></span>Aujourd'hui</span>
    <span data-test="roadmap-period">Du {{ roadmap.window.firstDay|date('d/m/Y') }} au {{ roadmap.window.lastDay|date('d/m/Y') }}</span>
</div>
