{#
    The details of a bar of the roadmap, shown by roadmap-tooltip on hover. Expects `id`, `row`, `bar` and `kind`:
    realized and overrun for a segment, whose `run` is then expected too, future or span for a whole bar.
#}
{% set legend = {
    realized: ['Saisi', 'rounded-sm bg-brand'],
    overrun: ["Saisi au-delà de l'estimation", 'rounded-sm bg-danger'],
    future: ['Restant, calculé', 'rounded-sm border border-dashed border-brand bg-brand-soft'],
    span: [row.lot ? 'Lot' : 'Projet', 'rounded-full bg-brand-medium'],
}[kind] %}
{% set run = kind in ['realized', 'overrun'] ? run : null %}
<div id="{{ id }}" role="tooltip" hidden class="pointer-events-none z-30 {{ run is null ? 'w-80' : 'w-96' }} rounded-base border border-default bg-neutral-primary-soft p-3 text-xs text-body shadow-md" data-test="roadmap-tooltip-{{ kind }}">
    <p class="text-sm font-semibold text-heading">{{ row.title }}</p>
    <p class="mt-1 flex items-center gap-1.5"><span class="inline-block h-2.5 w-5 {{ legend[1] }}"></span>{{ legend[0] }}</p>
    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 border-t border-default pt-2">
        <dt>Période</dt>
        <dd class="whitespace-nowrap text-heading" data-test="roadmap-tooltip-period">
            {{ bar.from|weekday }} {{ bar.from|date('d/m/Y') }} →
            {% if kind == 'span' and row.end is null %}fin inconnue{% else %}{{ bar.to|weekday }} {{ bar.to|date('d/m/Y') }}{% endif %}
        </dd>
        {% if run is not null %}
            <dt>Saisi</dt>
            <dd class="text-heading" data-test="roadmap-run-entered">{{ run.quarters|days }}</dd>
            <dt>Jours avec saisie</dt>
            <dd class="text-heading" data-test="roadmap-days-entered">{{ run.dayCount }}</dd>
        {% elseif kind == 'future' and row.progress %}
            <dt>Restant</dt>
            <dd class="text-heading" data-test="roadmap-remaining">{{ row.remainingQuarters|days }}</dd>
            {{ include('roadmap/_progress.html.twig') }}
        {% elseif kind == 'future' %}
            <dt>Restant</dt>
            <dd class="text-heading"><span data-test="roadmap-remaining">{{ row.remainingQuarters|days }}</span> sur {{ row.lot.estimateDays }} j estimés</dd>
        {% endif %}
        {% if row.leaf and (run.team ?? row.members) is not empty %}
            <dt>Équipe</dt>
            <dd>{{ include('roadmap/_team.html.twig', {lines: run.team ?? row.members, entered: run is not null}) }}</dd>
        {% endif %}
    </dl>
</div>
