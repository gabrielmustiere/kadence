{#
    The frame of a frieze: it scrolls when zoomed or when its weeks need more room than the page, holds the tooltips and
    the months, then the `rows` block. Expects `roadmap`. It sets --roadmap-labels, the width of the column of titles,
    narrower below md: every grid of the `rows` block lays out its columns on it rather than on a width of its own.
#}
<div class="relative overflow-x-auto rounded-card [--roadmap-labels:8.5rem] md:[--roadmap-labels:20rem] border border-default bg-surface shadow-card max-md:scroll-hint" style="--roadmap-weeks: {{ roadmap.window.weekCount }}; --roadmap-zoom: 1; --roadmap-min-track: {{ roadmap.minTrackRem|number_format(4, '.', '') }}rem" data-roadmap-target="scroller" data-controller="roadmap-tooltip" data-action="pointerover->roadmap-tooltip#show pointermove->roadmap-tooltip#show pointerout->roadmap-tooltip#leave focusin->roadmap-tooltip#show focusout->roadmap-tooltip#leave scroll->roadmap-tooltip#hide scroll@window->roadmap-tooltip#hide keydown.esc@window->roadmap-tooltip#hide turbo:before-cache@document->roadmap-tooltip#hide" data-test="roadmap">
    <div style="min-width: calc(var(--roadmap-labels) + max(var(--roadmap-min-track), 100% - var(--roadmap-labels)) * var(--roadmap-zoom))">
        <div class="grid grid-cols-[var(--roadmap-labels)_1fr] border-b border-default bg-neutral-secondary-soft">
            <div class="eyebrow sticky left-0 z-10 border-e border-default bg-neutral-secondary-soft px-4 py-2.5 text-body-subtle">Projet</div>
            <div class="relative h-9" data-roadmap-target="track" data-test="roadmap-months">
                {% for month in roadmap.months %}
                    <span class="eyebrow absolute inset-y-0 flex items-center whitespace-nowrap border-l border-default ps-2 text-body" style="left: {{ month[1]|number_format(4, '.', '') }}%">{{ month[0] }}</span>
                {% endfor %}
                {% if roadmap.todayPosition is not null %}
                    <span class="absolute bottom-0 size-2 -translate-x-1/2 translate-y-1/2 rounded-full bg-primary ring-2 ring-surface" style="left: {{ roadmap.todayPosition|number_format(4, '.', '') }}%" aria-hidden="true"></span>
                {% endif %}
            </div>
        </div>
        {% block rows %}{% endblock %}
    </div>
</div>
