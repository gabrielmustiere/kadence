{#
    Time entered against the estimate of each lot and sub-lot, then of the project. Expects `summary`.
#}
<div class="overflow-x-auto rounded-base border border-default">
    <twig:Table data-test="consumption">
        <twig:Table:Header>
            <twig:Table:Row>
                <twig:Table:Head>Lot</twig:Table:Head>
                <twig:Table:Head>Estimé</twig:Table:Head>
                <twig:Table:Head>Saisi</twig:Table:Head>
                <twig:Table:Head>Restant ou dépassement</twig:Table:Head>
            </twig:Table:Row>
        </twig:Table:Header>
        <twig:Table:Body>
            {% for lotSummary in summary.lots %}
                {{ include('roadmap/_consumption_row.html.twig', {line: lotSummary, title: lotSummary.lot.title, leaf: lotSummary.lot.leaf ? lotSummary.lot : null, nested: false}) }}
                {% for subLotSummary in lotSummary.children %}
                    {{ include('roadmap/_consumption_row.html.twig', {line: subLotSummary, title: subLotSummary.lot.title, leaf: subLotSummary.lot, nested: true}) }}
                {% endfor %}
            {% endfor %}
        </twig:Table:Body>
        <twig:Table:Footer class="border-t border-default">
            {{ include('roadmap/_consumption_row.html.twig', {line: summary, title: 'Projet', leaf: null, nested: false}) }}
        </twig:Table:Footer>
    </twig:Table>
</div>
