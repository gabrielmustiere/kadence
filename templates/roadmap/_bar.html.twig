{#
    A bar of the roadmap and its tooltips, shown by roadmap-tooltip. Expects `row`, `bar`, `kind` (see _tooltip), `class`
    and `test`. A bar made of segments is a box holding them, each segment with its own tooltip. The tooltips stay out
    of the box, whose transform would otherwise become their reference for a fixed position.
#}
{% set fade = bar.cutStart and bar.cutEnd
    ? 'linear-gradient(to right, transparent, black 12px, black calc(100% - 12px), transparent)'
    : (bar.cutStart ? 'linear-gradient(to right, transparent, black 12px)' : (bar.cutEnd ? 'linear-gradient(to left, transparent, black 12px)' : null)) %}
{% set tooltip = 'roadmap-tooltip-' ~ (row.lot ? 'lot-' ~ row.lot.id : 'project-' ~ row.project.id) ~ '-' ~ kind %}
<div class="absolute top-1/2 -translate-y-1/2 {{ bar.segments is empty ? class : (class ~ ' bg-transparent')|tailwind_merge }} {{ bar.cutStart ? 'rounded-l-none' : '' }} {{ bar.cutEnd ? 'rounded-r-none' : '' }}"
     style="{{ bar.style }}{% if fade %}; mask-image: {{ fade }}{% endif %}"
     {% if bar.segments is empty %}data-roadmap-tooltip="{{ tooltip }}"{% endif %}
     data-test="{{ test }}"
     data-cut-start="{{ bar.cutStart ? 'true' : 'false' }}"
     data-cut-end="{{ bar.cutEnd ? 'true' : 'false' }}"
     aria-hidden="true">
    {%- for segment in bar.segments %}
        <div class="absolute inset-y-0 {{ class }} {{ segment.bar.cutStart ? 'rounded-l-none' : '' }} {{ segment.bar.cutEnd ? 'rounded-r-none' : '' }}" style="{{ segment.bar.style }}" data-roadmap-tooltip="{{ tooltip }}-{{ loop.index }}" data-test="roadmap-segment-{{ kind }}"></div>
    {%- endfor -%}
</div>
{% for segment in bar.segments %}
    {{ include('roadmap/_tooltip.html.twig', {id: tooltip ~ '-' ~ loop.index, bar: segment.run, run: segment.run}) }}
{% else %}
    {{ include('roadmap/_tooltip.html.twig', {id: tooltip}) }}
{% endfor %}
