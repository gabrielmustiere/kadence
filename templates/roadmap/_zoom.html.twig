{#
    The zoom buttons of a frieze, driven by the roadmap controller.
#}
<div class="inline-flex items-center gap-0.5 rounded-xl border border-default bg-surface p-1" role="group" aria-label="Zoom de la frise">
    <twig:Button type="button" size="icon-xs" variant="ghost" class="rounded-lg" aria-label="Dézoomer la frise" data-roadmap-target="zoomOut" data-action="roadmap#zoomOut" data-test="roadmap-zoom-out">
        <twig:ux:icon name="tabler:zoom-out" class="size-4"/>
    </twig:Button>
    <span class="min-w-9 text-center text-[13px] font-medium tabular-nums text-heading" aria-live="polite" data-roadmap-target="zoomLevel" data-test="roadmap-zoom-level">×1</span>
    <twig:Button type="button" size="icon-xs" variant="ghost" class="rounded-lg" aria-label="Zoomer la frise" data-roadmap-target="zoomIn" data-action="roadmap#zoomIn" data-test="roadmap-zoom-in">
        <twig:ux:icon name="tabler:zoom-in" class="size-4"/>
    </twig:Button>
    <span class="mx-0.5 h-5 w-px bg-default" aria-hidden="true"></span>
    <twig:Button type="button" size="xs" variant="ghost" class="h-8 rounded-lg tabular-nums" aria-label="Revenir au zoom 100 %" data-roadmap-target="zoomReset" data-action="roadmap#zoomReset" data-test="roadmap-zoom-reset">100 %</twig:Button>
</div>
