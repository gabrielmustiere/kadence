{#
    A line of the consumption table. Expects `line` (a lot or project summary), `title`, `leaf` (the lot when it is a
    leaf, null otherwise) and `nested`.
#}
{% set toEstimate = leaf is not null and leaf.estimateDays is null %}
<twig:Table:Row data-test="consumption-row" data-title="{{ title }}">
    <twig:Table:Cell class="{{ nested ? 'ps-10' : 'font-medium text-heading' }}">
        <div class="flex items-center gap-2">
            {% if nested %}<twig:ux:icon name="tabler:corner-down-right" class="size-4 shrink-0 text-body"/>{% endif %}
            <span>{{ title }}</span>
        </div>
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap" data-test="consumption-estimate">
        {% if toEstimate %}
            <twig:Badge variant="warning" data-test="leaf-to-estimate">à estimer</twig:Badge>
        {% elseif leaf is not null %}
            {{ leaf.estimateDays }} j
        {% else %}
            {{ include('project/_estimate.html.twig', {summary: line}) }}
        {% endif %}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap" data-test="consumption-entered">{{ line.enteredQuarters|days }}</twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap">
        {% if toEstimate %}
            <span class="text-body">—</span>
        {% else %}
            {% if line.remainingQuarters > 0 or line.overrunQuarters == 0 %}
                <span data-test="consumption-remaining">{{ line.remainingQuarters|days }}</span>
            {% endif %}
            {% if line.remainingQuarters > 0 and line.overrunQuarters > 0 %}<span class="text-body"> · </span>{% endif %}
            {% if line.overrunQuarters > 0 %}
                <span class="font-medium text-fg-danger-strong" data-test="consumption-overrun">{{ line.overrunQuarters|days }} de dépassement</span>
            {% endif %}
        {% endif %}
    </twig:Table:Cell>
</twig:Table:Row>
