{#
    A line of the consumption table. Expects `line` (a lot or project summary), `title`, `leaf` (the lot when it is a
    leaf, null otherwise), `nested` and `scale`, the quarters shared by the rulers of the table, null on the line of the
    project.
#}
{% set toEstimate = leaf is not null and leaf.estimateDays is null %}
<twig:Table:Row data-test="consumption-row" data-title="{{ title }}">
    <twig:Table:Cell class="{{ nested ? 'ps-11 text-heading' : 'font-medium text-heading' }}">
        <div class="flex items-center gap-2">
            {% if nested %}<twig:ux:icon name="tabler:corner-down-right" class="size-4 shrink-0 text-body-subtle"/>{% endif %}
            <span>{{ title }}</span>
        </div>
    </twig:Table:Cell>
    <twig:Table:Cell>
        {% if scale is not null %}
            <twig:Ruler :entered="line.enteredQuarters" :remaining="line.remainingQuarters" :overrun="line.overrunQuarters" :estimate="line.estimateDays * 4" :projected="leaf is not null ? line.projectedQuarters : null" :scale="scale"/>
        {% endif %}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap tabular-nums" data-test="consumption-estimate">
        {% if toEstimate %}
            <twig:Badge variant="warning" data-test="leaf-to-estimate">à estimer</twig:Badge>
        {% elseif leaf is not null %}
            {{ leaf.estimateDays }} j
        {% else %}
            {{ include('project/_estimate.html.twig', {summary: line}) }}
        {% endif %}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap tabular-nums text-heading" data-test="consumption-entered">
        {{- line.enteredQuarters|days -}}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap tabular-nums">
        {% if toEstimate %}
            <span class="text-body">—</span>
        {% else %}
            {% if line.remainingQuarters > 0 or line.overrunQuarters == 0 %}
                <span data-test="consumption-remaining">{{ line.remainingQuarters|days }}</span>
            {% endif %}
            {% if line.overrunQuarters > 0 %}
                <span class="block font-medium text-fg-danger-strong" data-test="consumption-overrun">{{ line.overrunQuarters|days }} de dépassement</span>
            {% endif %}
        {% endif %}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap tabular-nums" data-test="consumption-progress">
        {% if leaf is not null %}
            {% if line.progress and line.progress.percent > 0 %}
                {{ line.progress.percent }} %
                <span class="block text-xs text-body">au {{ line.progress.declaredOn|date('d/m') }}</span>
            {% else %}
                <span class="text-body">—</span>
            {% endif %}
        {% elseif line.progressPercent is not null %}
            {{ line.progressPercent }} %
            {% if line.isPartial %}<span class="block text-xs text-body" data-test="consumption-progress-partial">partiel</span>{% endif %}
        {% else %}
            <span class="text-body">—</span>
        {% endif %}
    </twig:Table:Cell>
    <twig:Table:Cell class="whitespace-nowrap tabular-nums" data-test="consumption-projected">
        {% if leaf is not null and line.projectedQuarters is not null %}
            {% set gap = line.projectedGapQuarters %}
            {{ line.projectedQuarters|days }}
            {% if gap != 0 %}<span class="{{ gap > 0 ? 'font-medium text-fg-danger-strong' : 'text-body' }}">({{ gap > 0 ? '+' }}{{ gap|days }})</span>{% endif %}
        {% else %}
            <span class="text-body">—</span>
        {% endif %}
    </twig:Table:Cell>
</twig:Table:Row>
