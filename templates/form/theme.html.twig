{# The Flowbite form theme, set to the tokens of the Cadence design system. #}
{% use '@TalesFromADevFlowbite/form/default.html.twig' %}

{# Expanded choices render as chips: the whole option is the hit area, the control stays visible. #}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' flex flex-wrap gap-2')|trim|tailwind_merge}) -%}
    <div {{ block('widget_container_attributes') }}>
    {%- for child in form %}
        <div class="choice-chip">
            {{- form_widget(child, {attr: child.vars.attr|merge({class: 'relative z-10'})}) -}}
        </div>
    {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_radio_label -%}
    {%- if widget is defined and form.parent is not null and form.parent.vars.expanded|default(false) -%}
        {%- if checked and form.parent.vars.valid == false -%}
            {%- set valid = false -%}
        {%- endif -%}
        {%- set label_attr = label_attr|merge({for: id, class: ('choice-chip-label ' ~ label_attr.class|default(''))|trim}) -%}
        {{ widget|raw }}
        <label{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
            {%- if label is not same as(false) -%}
                {{- block('form_label_content') -}}
            {%- endif -%}
        </label>
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock checkbox_radio_label -%}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({'class': (row_attr.class|default('mb-5'))|trim|tailwind_merge}) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{% block class_label -%}
    block mb-1.5 text-[13px] font-medium text-heading
{%- endblock class_label %}

{% block class_input_radio_label -%}
    select-none ms-2 text-sm text-heading cursor-pointer
{%- endblock class_input_radio_label %}

{% block class_input_text -%}
    block w-full rounded-base border border-default-medium bg-surface px-3 py-2.5 text-sm text-heading shadow-xs transition-[border-color,box-shadow] placeholder:text-body-subtle hover:border-default-strong focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand-medium/50
{%- endblock class_input_text %}

{% block class_input_file -%}
    block w-full cursor-pointer rounded-base border border-default-medium bg-surface text-sm text-heading shadow-xs focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand-medium/50
{%- endblock class_input_file %}

{% block class_input_radio -%}
    size-4 rounded-full border
{%- endblock class_input_radio %}

{% block class_input_checkbox -%}
    size-4 rounded-[5px] border
{%- endblock class_input_checkbox %}

{% block class_select -%}
    {{ block('class_input_text') }} cursor-pointer
{%- endblock class_select %}

{% block class_button -%}
    inline-flex h-10 items-center justify-center rounded-base border border-default bg-surface px-4 text-sm font-medium text-heading shadow-xs transition-colors hover:bg-neutral-secondary-soft focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-medium
{%- endblock class_button %}

{% block class_submit -%}
    inline-flex h-10 items-center justify-center rounded-base border border-transparent bg-primary px-4 text-sm font-medium text-on-primary shadow-xs transition-colors hover:bg-primary-strong focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-medium
{%- endblock class_submit %}

{% block class_addon -%}
    inline-flex items-center px-3 text-sm text-body bg-neutral-tertiary border-y border-default-medium
{%- endblock class_addon %}

{% block class_help_text -%}
    mt-1.5 text-[13px] leading-relaxed text-body
{%- endblock class_help_text %}

{% block class_label_error -%}
    block mb-1.5 text-[13px] font-medium text-fg-danger-strong
{%- endblock class_label_error %}

{% block class_input_radio_label_error -%}
    select-none ms-2 text-sm text-fg-danger-strong cursor-pointer
{%- endblock class_input_radio_label_error %}

{% block class_input_error -%}
    border-danger bg-danger-soft/40 focus:border-danger focus:ring-danger-medium
{%- endblock class_input_error %}

{% block class_text_error -%}
    mt-1.5 flex items-center gap-1 text-[13px] font-medium text-fg-danger-strong
{%- endblock class_text_error %}
