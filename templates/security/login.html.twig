{% extends 'security.html.twig' %}

{% block title %}Connexion · Kadence{% endblock %}

{% block body %}
    <div class="grid min-h-screen grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">

        {# Form column #}
        <div class="flex flex-col justify-between px-6 py-8 sm:px-12 lg:px-16">

            <div class="flex items-center gap-2.5">
                <twig:Logo class="size-9"/>
                <div class="leading-tight">
                    <div class="text-base font-bold tracking-tight text-heading [font-stretch:118%]" translate="no">Kadence</div>
                    <div class="eyebrow text-body-subtle">Pilotage de production</div>
                </div>
            </div>

            <div class="mx-auto w-full max-w-sm py-12">
                <h1 class="font-display text-[2.5rem] leading-none text-heading">Se connecter</h1>
                <p class="mt-3 text-[15px] text-body">
                    Identifiez-vous pour accéder à l'espace de travail.
                </p>

                {% set dev_login = dev_users is not empty %}
                {% set dev_default_email = last_username ?: 'admin@example.com' %}
                <form method="post" class="mt-8 space-y-5"
                      {% if dev_login %}data-controller="dev-login" data-dev-login-password-value="password"{% endif %}>
                    {% if error %}
                        <div role="alert" class="flex items-start gap-3 rounded-xl border border-danger-subtle bg-danger-soft p-3.5">
                            <twig:ux:icon name="tabler:alert-circle-filled" class="mt-px size-5 shrink-0 text-danger"/>
                            <div class="text-sm leading-relaxed text-fg-danger-strong">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="flex items-start gap-3 rounded-xl border border-brand-subtle bg-brand-softer p-3.5">
                            <twig:ux:icon name="tabler:user-check" class="mt-px size-5 shrink-0 text-fg-brand"/>
                            <div class="text-sm leading-relaxed text-fg-brand-strong">
                                Connecté en tant que <span class="font-medium">{{ app.user.userIdentifier }}</span>.
                                <a href="{{ logout_path() }}" class="ml-1 font-medium underline hover:no-underline">Se déconnecter</a>
                            </div>
                        </div>
                    {% endif %}

                    {% if dev_login %}
                        <div class="rounded-xl border border-dashed border-warning-subtle bg-warning-soft/70 p-3.5">
                            <label for="dev-login-user" class="mb-2 flex items-center gap-1.5 text-[13px] font-medium text-fg-warning">
                                <twig:ux:icon name="tabler:bolt" class="size-4"/>
                                Connexion rapide (dev uniquement)
                            </label>
                            <twig:Select id="dev-login-user" data-test="dev-login-user" data-action="dev-login#fill">
                                {% for dev_user in dev_users %}
                                    <option value="{{ dev_user.email }}" {{ dev_user.email == dev_default_email ? 'selected' }}>
                                        {{ dev_user.firstName }} {{ dev_user.lastName }} — {{ dev_user.role.label }}{{ dev_user.active ? '' : ' (désactivé)' }}
                                    </option>
                                {% endfor %}
                            </twig:Select>
                            <p class="mt-2 text-xs text-fg-warning">Remplit l'e-mail et le mot de passe des fixtures (<span class="font-mono">password</span>).</p>
                        </div>
                    {% endif %}

                    <div>
                        <twig:Label for="username" class="mb-1.5">Email</twig:Label>
                        <twig:Input id="username" type="email" name="_username" value="{{ dev_login ? dev_default_email : last_username }}"
                                    :data-dev-login-target="dev_login ? 'username' : false"
                                    required autocomplete="username" spellcheck="false" autofocus
                                    placeholder="vous@exemple.com" class="h-11"/>
                    </div>

                    <div>
                        <twig:Label for="password" class="mb-1.5">Mot de passe</twig:Label>
                        <twig:Input id="password" type="password" name="_password" required
                                    :value="dev_login ? 'password' : false" :data-dev-login-target="dev_login ? 'password' : false"
                                    autocomplete="current-password"
                                    placeholder="••••••••" class="h-11"/>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                           value="{{ csrf_token('authenticate') }}">

                    <twig:Button type="submit" size="lg" class="w-full">
                        Se connecter
                    </twig:Button>
                </form>

            </div>

            <p class="text-center text-xs text-body-subtle lg:text-left">© {{ "now"|date("Y") }} Kadence, outil interne de pilotage</p>
        </div>

        {# Decorative column: four projects as rulers, what was entered then what remains. #}
        <div class="relative m-3 hidden overflow-hidden rounded-[14px] bg-blue-black lg:block" aria-hidden="true">
            <div class="relative flex h-full flex-col justify-between gap-16 p-12 text-white">
                <div class="space-y-5 pt-6">
                    {% for bar in [
                        {label: 'Atlas', done: 30, todo: 10},
                        {label: 'Nova', done: 18, todo: 14},
                        {label: 'Orion', done: 34, todo: 4},
                        {label: 'Vega', done: 9, todo: 23},
                    ] %}
                        <div>
                            <span class="text-sm font-medium text-pen-200">{{ bar.label }}</span>
                            <div class="ruler mt-2" style="--ruler-cells: 40; --ruler-gap: 3px; --ruler-gap-color: var(--color-blue-black)">
                                <div class="ruler-track h-4">
                                    <span class="ruler-done bg-pen-300" style="width: {{ bar.done / 40 * 100 }}%"></span>
                                    <span class="ruler-rest bg-pen-950 bg-[repeating-linear-gradient(-45deg,var(--color-pen-800)_0_3px,transparent_3px_7px)]" style="left: {{ bar.done / 40 * 100 }}%; width: {{ bar.todo / 40 * 100 }}%"></span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="max-w-lg">
                    <h2 class="font-display text-[2rem] leading-[1.12]">
                        Savoir à date ce que l'équipe peut encore absorber, et quand chaque projet sera livré.
                    </h2>
                    <p class="mt-5 max-w-md text-sm leading-relaxed text-pen-200">
                        Temps passés, estimé face au réalisé, capacité de l'équipe et dates projetées, au même endroit.
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
