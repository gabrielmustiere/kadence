{% extends 'base.html.twig' %}

{% block title %}Projets · Kadence{% endblock %}

{% block body %}
    <twig:PageHeader title="Projets" description="Les projets, leur découpage en lots et sous-lots, et ce qu'il reste à estimer ou à confier.">
        {% if is_granted('ROLE_LEAD') %}
            <twig:Button as="a" href="{{ path('app_project_new') }}" data-test="project-new">
                <twig:ux:icon name="tabler:plus" class="size-4"/>
                Nouveau projet
            </twig:Button>
        {% endif %}
    </twig:PageHeader>

    <nav class="mb-5 inline-flex items-center gap-0.5 rounded-xl border border-default bg-surface p-1 shadow-xs" aria-label="Filtrer les projets">
        {{ _self.filter(path('app_project_index'), 'Tous les projets', not mine, 'filter-all') }}
        {{ _self.filter(path('app_project_index', {'mes-responsabilites': 1}), 'Mes responsabilités', mine, 'filter-mine') }}
    </nav>

    {% if projects is empty %}
        <twig:EmptyState icon="tabler:folders" data-test="projects-empty">
            {% if mine %}
                Vous n'êtes responsable d'aucun lot ni sous-lot pour l'instant.
            {% else %}
                Aucun projet pour l'instant.
            {% endif %}
        </twig:EmptyState>
    {% else %}
        <twig:TableCard>
            <twig:Table data-test="projects-table">
                <twig:Table:Header>
                    <twig:Table:Row>
                        <twig:Table:Head>Projet</twig:Table:Head>
                        <twig:Table:Head>Estimation</twig:Table:Head>
                        <twig:Table:Head>À compléter</twig:Table:Head>
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body>
                    {% for summary in projects %}
                        <twig:Table:Row data-test="project-row" data-title="{{ summary.project.title }}">
                            <twig:Table:Cell class="font-medium text-heading">
                                <div class="flex items-center gap-3">
                                    {{ include('project/_monogram.html.twig', {project: summary.project}) }}
                                    <a href="{{ path('app_project_show', {id: summary.project.id}) }}" class="decoration-default-strong underline-offset-4 hover:underline" data-test="project-link">{{ summary.project.title }}</a>
                                </div>
                            </twig:Table:Cell>
                            <twig:Table:Cell class="tabular-nums">
                                {% if summary.isUnsplit %}
                                    <span class="text-body-subtle">—</span>
                                {% else %}
                                    {{ include('project/_estimate.html.twig') }}
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell>
                                {% if summary.isUnsplit %}
                                    <twig:Badge variant="gray" data-test="signal-unsplit">à découper</twig:Badge>
                                {% else %}
                                    {{ include('project/_signals.html.twig') }}
                                {% endif %}
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:TableCard>
    {% endif %}
{% endblock %}

{% macro filter(href, label, current, test_id) %}
    <a href="{{ href }}" data-test="{{ test_id }}" {% if current %}aria-current="page"{% endif %}
       class="inline-flex h-8 items-center rounded-lg px-3 text-sm font-medium transition-colors {{ current ? 'bg-primary text-on-primary shadow-xs' : 'text-body hover:bg-neutral-tertiary hover:text-heading' }}">{{ label }}</a>
{% endmacro %}
