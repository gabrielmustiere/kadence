{#
    Every lot and sub-lot of the project in the order of its split, with what may be done on each, then the project.
    Expects `summary` and `back`, the view of the roadmap the page was opened from.
#}
{% set scale = 0 %}
{% for lotSummary in summary.lots %}
    {% for line in [lotSummary]|merge(lotSummary.children) %}
        {% set scale = max(scale, line.enteredQuarters + line.remainingQuarters, line.estimateDays * 4, line.projectedQuarters ?? 0) %}
    {% endfor %}
{% endfor %}
<twig:TableCard>
    <twig:Table stack data-test="lots-table">
        <twig:Table:Header>
            <twig:Table:Row>
                <twig:Table:Head>Lot</twig:Table:Head>
                <twig:Table:Head>Responsable</twig:Table:Head>
                <twig:Table:Head>Estimation</twig:Table:Head>
                <twig:Table:Head class="min-w-44">Saisi</twig:Table:Head>
                <twig:Table:Head>Restant ou dépassement</twig:Table:Head>
                <twig:Table:Head>Avancement</twig:Table:Head>
                <twig:Table:Head>Projeté</twig:Table:Head>
                <twig:Table:Head><span class="sr-only">Actions</span></twig:Table:Head>
            </twig:Table:Row>
        </twig:Table:Header>
        <twig:Table:Body>
            {% for lotSummary in summary.lots %}
                {{ include('project/_lot_row.html.twig', {summary: lotSummary, nested: false, scale: scale}) }}
                {% for subLotSummary in lotSummary.children %}
                    {{ include('project/_lot_row.html.twig', {summary: subLotSummary, nested: true, scale: scale}) }}
                {% endfor %}
            {% endfor %}
        </twig:Table:Body>
        <twig:Table:Footer class="border-t border-default">
            <twig:Table:Row data-test="lot-total-row" data-title="Projet">
                <twig:Table:Cell class="font-medium text-heading">Projet</twig:Table:Cell>
                <twig:Table:Cell/>
                <twig:Table:Cell class="whitespace-nowrap tabular-nums" data-label="Estimation" data-test="consumption-estimate">{{ include('project/_estimate.html.twig') }}</twig:Table:Cell>
                <twig:Table:Cell class="whitespace-nowrap tabular-nums text-heading" data-label="Saisi" data-test="consumption-entered">{{ summary.enteredQuarters|days }}</twig:Table:Cell>
                <twig:Table:Cell class="whitespace-nowrap tabular-nums max-md:whitespace-normal" data-label="Restant ou dépassement">{{ include('project/_remaining.html.twig', {line: summary}) }}</twig:Table:Cell>
                <twig:Table:Cell class="whitespace-nowrap tabular-nums" data-label="Avancement" data-test="consumption-progress">
                    {% if summary.progressPercent is not null %}
                        {{ summary.progressPercent }} %
                        {% if summary.isPartial %}<span class="block text-xs text-body" data-test="consumption-progress-partial">sur les lots estimés</span>{% endif %}
                    {% else %}
                        <span class="text-body">—</span>
                    {% endif %}
                </twig:Table:Cell>
                <twig:Table:Cell class="tabular-nums" data-label="Projeté" data-test="consumption-projected"><span class="text-body">—</span></twig:Table:Cell>
                <twig:Table:Cell/>
            </twig:Table:Row>
        </twig:Table:Footer>
    </twig:Table>
</twig:TableCard>
