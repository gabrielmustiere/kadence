{{ form_start(form, {attr: {'data-test': 'project-form'}}) }}
    <div class="divide-y divide-default-subtle">
        <twig:FormSection title="Présentation" description="Le nom sous lequel le projet apparaît partout, et ce qu'il recouvre." class="pt-0">
            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
        </twig:FormSection>
    </div>
    {{ include('common/_form_actions.html.twig', {submit_test: 'project-submit'}) }}
{{ form_end(form) }}
