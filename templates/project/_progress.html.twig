{#
    The progress of a leaf on the page of its project: the form to declare it for whoever may, the progress in force
    otherwise. Expects `summary`, the summary of the leaf, and `back`, the view of the roadmap the page was opened from.
#}
{% set lot = summary.lot %}
{% set declaration = summary.progress %}
{% if is_granted('LOT_PROGRESS', lot) %}
    <form method="post" action="{{ path('app_lot_progress', {id: lot.id}) }}" class="flex items-center gap-1.5" data-test="progress-form">
        <input type="hidden" name="_token" value="{{ csrf_token('lot-progress-' ~ lot.id) }}">
        {% if back %}<input type="hidden" name="roadmap" value="{{ back.week.iso }}">{% endif %}
        {% if back.signal ?? null %}<input type="hidden" name="signal" value="{{ back.signal.value }}">{% endif %}
        <label for="progress-{{ lot.id }}" class="sr-only">Avancement de « {{ lot.title }} »</label>
        <twig:Select id="progress-{{ lot.id }}" name="percent" required autocomplete="off" class="h-10 w-40 ps-2.5 text-base tabular-nums sm:h-8 sm:w-[7.5rem] sm:text-[13px]" data-test="progress-select">
            {% if declaration is null %}
                <option value="" selected>Non déclaré</option>
            {% endif %}
            {% for percent in constant('App\\Entity\\LotProgress::PERCENTS') %}
                <option value="{{ percent }}" {{ declaration and percent == declaration.percent ? 'selected' }}>{{ percent }} %</option>
            {% endfor %}
        </twig:Select>
        <twig:Button type="submit" size="xs" variant="outline" class="h-10 sm:h-8" data-test="progress-submit">Enregistrer<span class="sr-only"> l'avancement de « {{ lot.title }} »</span></twig:Button>
    </form>
    {% if declaration %}
        <span class="mt-1 block whitespace-nowrap text-xs text-body-subtle" data-test="progress-declared-on">déclaré le {{ declaration.declaredOn|date('d/m') }}</span>
    {% endif %}
{% elseif declaration and declaration.percent > 0 %}
    <span class="whitespace-nowrap tabular-nums text-heading" data-test="progress">{{ declaration.percent }} %</span>
    <span class="block whitespace-nowrap text-xs text-body" data-test="progress-declared-on">au {{ declaration.declaredOn|date('d/m') }}</span>
{% else %}
    <span class="text-body-subtle" data-test="progress-none">—</span>
{% endif %}
