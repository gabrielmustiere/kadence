<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Turbo 8 : pas de préchargement au survol (évite notamment un GET /logout au survol) #}
    <meta name="turbo-prefetch" content="false">
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)">
    <title>{% block title %}Connexion · Kadence{% endblock %}</title>
    {{ include('common/_head.html.twig') }}
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="h-full bg-canvas font-sans text-body antialiased">

{% include 'common/flash-messages.html.twig' %}

<main>
    {% block body %}{% endblock %}
</main>

</body>
</html>
