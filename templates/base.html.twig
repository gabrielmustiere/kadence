<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Turbo 8 : pas de préchargement au survol (évite notamment un GET /logout au survol) #}
    <meta name="turbo-prefetch" content="false">
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)">
    <title>{% block title %}Kadence{% endblock %}</title>
    {{ include('common/_head.html.twig') }}
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-full bg-canvas font-sans text-body antialiased">
<a href="#contenu" data-turbo="false" class="sr-only z-[60] rounded-base bg-primary px-4 py-2 text-sm font-medium text-on-primary focus:not-sr-only focus:fixed focus:top-2 focus:left-2">Aller au contenu</a>

{# Topbar #}
<header class="fixed inset-x-0 top-0 z-50 h-14 border-b border-default bg-canvas/85 backdrop-blur-md backdrop-saturate-150">
    <div class="flex h-full items-center justify-between gap-4 px-3 sm:px-4">
        <div class="flex items-center gap-1">
            <button data-drawer-target="app-sidebar" data-drawer-toggle="app-sidebar"
                    aria-controls="app-sidebar" type="button" data-test="sidebar-toggle"
                    class="grid size-9 cursor-pointer place-items-center rounded-lg text-body transition-colors hover:bg-neutral-tertiary hover:text-heading md:hidden">
                <twig:ux:icon name="tabler:menu-2" class="size-5"/>
                <span class="sr-only">Ouvrir le menu</span>
            </button>
            <a href="{{ path('app_page') }}" class="flex items-center gap-2.5 rounded-lg py-1 pe-2 ps-1 md:w-[14.5rem]">
                <twig:Logo class="size-7"/>
                <span class="text-[17px] font-bold tracking-tight text-heading [font-stretch:118%]" translate="no">Kadence</span>
            </a>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
            <button type="button" data-controller="theme" data-action="theme#toggle" aria-pressed="false" title="Thème clair ou sombre"
                    class="grid size-9 place-items-center rounded-full text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">
                <twig:ux:icon name="tabler:moon" class="size-[18px] dark:hidden"/>
                <twig:ux:icon name="tabler:sun" class="hidden size-[18px] dark:block"/>
                <span class="sr-only">Thème sombre</span>
            </button>
            <span class="hidden items-center gap-2.5 rounded-base border border-default bg-surface px-3 py-1 text-xs tabular-nums text-body lg:inline-flex">
                <span class="font-semibold text-heading">Semaine {{ 'now'|date('W') }}</span>
                <span class="h-3 w-px bg-default-medium" aria-hidden="true"></span>
                {{ 'now'|date('d/m/Y') }}
            </span>
            {% if app.user %}
                <button type="button" data-dropdown-toggle="app-topbar-user-menu" data-dropdown-placement="bottom-end" data-test="user-menu-toggle"
                        class="flex items-center gap-2.5 rounded-full p-0.5 transition-colors hover:bg-neutral-tertiary sm:pe-3">
                    <twig:Avatar :user="app.user" tone="ink"/>
                    <span class="sr-only text-left leading-tight sm:not-sr-only sm:block">
                        <span class="block text-[13px] font-medium text-heading">{{ app.user.firstName }}</span>
                        <span class="block text-[11px] text-body">{{ app.user.role.label }}</span>
                    </span>
                    <twig:ux:icon name="tabler:chevron-down" class="hidden size-3.5 text-body sm:block"/>
                </button>
                <div class="z-50 hidden w-64 overflow-hidden rounded-card border border-default bg-surface text-sm shadow-lg"
                     id="app-topbar-user-menu">
                    <div class="flex items-center gap-3 px-4 py-3.5">
                        <twig:Avatar :user="app.user" tone="ink"/>
                        <div class="min-w-0">
                            <span class="block truncate font-medium text-heading" data-test="user-menu-name">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                            <span class="block truncate text-xs text-body">{{ app.user.role.label }}</span>
                        </div>
                    </div>
                    <ul class="border-t border-default p-1.5 text-body">
                        <li>
                            <a href="{{ path('app_account_password') }}" data-test="nav-account"
                               class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 transition-colors hover:bg-neutral-tertiary hover:text-heading">
                                <twig:ux:icon name="tabler:user-circle" class="size-4"/> Mon compte
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('app_person', {id: app.user.id}) }}" data-test="nav-person"
                               class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 transition-colors hover:bg-neutral-tertiary hover:text-heading">
                                <twig:ux:icon name="tabler:id-badge-2" class="size-4"/> Ma fiche
                            </a>
                        </li>
                    </ul>
                    <ul class="border-t border-default p-1.5">
                        <li>
                            <a href="{{ path('app_logout') }}" data-test="logout-link"
                               class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-fg-danger transition-colors hover:bg-danger-soft">
                                <twig:ux:icon name="tabler:logout" class="size-4"/> Déconnexion
                            </a>
                        </li>
                    </ul>
                </div>
            {% else %}
                <twig:Button as="a" size="sm" href="{{ path('app_login') }}">
                    <twig:ux:icon name="tabler:login" class="size-4"/> Se connecter
                </twig:Button>
            {% endif %}
        </div>
    </div>
</header>

{# Sidebar #}
{% set nav = nav_section(app.current_route) %}
<aside id="app-sidebar" data-controller="sidebar"
       class="fixed top-0 left-0 z-40 h-screen w-64 -translate-x-full border-r border-default bg-canvas pt-14 transition-transform md:translate-x-0"
       aria-label="Navigation principale">
    <div class="flex h-full flex-col overflow-y-auto overscroll-contain px-3 py-5">
        <ul class="shrink-0 space-y-0.5">
            <li>
                <twig:NavLink href="{{ path('app_page') }}" icon="tabler:layout-grid" :active="nav == 'dashboard'" data-test="nav-dashboard">Tableau de bord</twig:NavLink>
            </li>
            <li>
                <twig:NavLink href="{{ path('app_timesheet') }}" icon="tabler:calendar-week" :active="nav == 'timesheet'" data-test="nav-timesheet">Ma semaine</twig:NavLink>
            </li>
            <li>
                <twig:NavLink href="{{ path('app_roadmap') }}" icon="tabler:timeline-event" :active="nav == 'roadmap'" data-test="nav-roadmap">Roadmap</twig:NavLink>
            </li>
        </ul>
        <div class="mt-auto shrink-0 pt-6" data-test="nav-admin">
            <p id="nav-admin-title" class="eyebrow mb-2 px-3 text-body-subtle">Administration</p>
            <ul class="space-y-0.5" aria-labelledby="nav-admin-title">
                <li>
                    <twig:NavLink href="{{ path('app_project_index') }}" icon="tabler:folders" :active="nav == 'projects'" data-test="nav-projects">Projets</twig:NavLink>
                </li>
                {% if is_granted('ROLE_DIRECTION') %}
                <li>
                    <twig:NavLink href="{{ path('app_team_index') }}" icon="tabler:users" :active="nav == 'team'" data-test="nav-team">Équipe</twig:NavLink>
                </li>
                <li>
                    <twig:NavLink href="{{ path('app_tag_index') }}" icon="tabler:tags" :active="nav == 'tags'" data-test="nav-tags">Tags</twig:NavLink>
                </li>
                <li>
                    <twig:NavLink href="{{ path('app_holiday_index') }}" icon="tabler:calendar-off" :active="nav == 'holidays'" data-test="nav-holidays">Jours fériés</twig:NavLink>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>
</aside>

<main id="contenu" tabindex="-1" class="min-h-screen pt-14 outline-none md:ml-64">
    <div class="mx-auto w-full max-w-[96rem] px-4 py-6 sm:px-6 lg:px-10 lg:pt-8 lg:pb-12">
        {% block body %}{% endblock %}
    </div>
</main>

{% include 'common/flash-messages.html.twig' %}

</body>
</html>
