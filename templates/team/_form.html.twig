{{ form_start(form, {attr: {'data-test': 'team-member-form'}}) }}
    <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
    </div>
    {{ form_row(form.email) }}
    {{ form_row(form.role) }}
    {{ form_row(form.holidayCalendar) }}
    <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        {{ form_row(form.weeklyMaxDays) }}
        {{ form_row(form.weeklyMaxFrom) }}
    </div>
    <div class="mt-6 flex items-center gap-3">
        <twig:Button type="submit" data-test="team-member-submit">{{ submit_label }}</twig:Button>
        <a href="{{ path('app_team_index') }}" class="text-sm text-body underline hover:no-underline">Annuler</a>
    </div>
{{ form_end(form) }}
