{{ form_start(form, {attr: {'data-test': 'team-member-form'}}) }}
    <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
    </div>
    {{ form_row(form.email) }}
    {{ form_row(form.role) }}
    {{ form_row(form.holidayCalendar) }}
    <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
        {{ form_row(form.weeklyMaxDays) }}
        {{ form_row(form.weeklyMaxFrom) }}
    </div>
    <fieldset class="mt-2 border-t border-default pt-5" data-test="member-profile">
        <legend class="sr-only">Profil</legend>
        <p class="mb-4 text-sm text-body">Le profil aide les leads à composer l'équipe des feuilles. Cochez les tags existants ou saisissez-en de nouveaux.</p>
        {% for pair in [[form.technicalSkills, form.newTechnicalSkills], [form.functionalExperiences, form.newFunctionalExperiences], [form.teamType, form.newTeamType]] %}
            <div class="mb-5 grid grid-cols-1 gap-x-6 sm:grid-cols-2">
                {{ form_row(pair[0]) }}
                {{ form_row(pair[1]) }}
            </div>
        {% endfor %}
        <div class="sm:w-1/2 sm:pe-3">{{ form_row(form.manager) }}</div>
    </fieldset>
    <div class="mt-6 flex items-center gap-3">
        <twig:Button type="submit" data-test="team-member-submit">{{ submit_label }}</twig:Button>
        <a href="{{ path('app_team_index') }}" class="text-sm text-body underline hover:no-underline">Annuler</a>
    </div>
{{ form_end(form) }}
