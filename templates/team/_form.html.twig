{{ form_start(form, {attr: {'data-test': 'team-member-form'}}) }}
    <div class="divide-y divide-default-subtle">
        <twig:FormSection title="Identité et accès" description="Le nom affiché dans Kadence, l'e-mail de connexion et le rôle, qui fixe les droits." class="pt-0">
            <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
            </div>
            {{ form_row(form.email) }}
            {{ form_row(form.role) }}
        </twig:FormSection>
        <twig:FormSection title="Temps de travail" description="Les jours fériés et le maximum hebdomadaire bornent ce que la personne peut saisir.">
            {{ form_row(form.holidayCalendar) }}
            <div class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
                {{ form_row(form.weeklyMaxDays) }}
                {{ form_row(form.weeklyMaxFrom) }}
            </div>
        </twig:FormSection>
        <twig:FormSection title="Rattachement" description="L'équipe dont la personne fait partie et celle à qui elle rapporte.">
            {{ form_row(form.teamType) }}
            <div class="sm:w-1/2 sm:pe-3">{{ form_row(form.newTeamType) }}</div>
            <div class="sm:w-1/2 sm:pe-3">{{ form_row(form.manager) }}</div>
        </twig:FormSection>
        <twig:FormSection title="Compétences" description="Elles aident les leads à composer l'équipe des feuilles. Cochez les tags existants ou saisissez-en de nouveaux." data-test="member-profile">
            {{ form_row(form.technicalSkills) }}
            {{ form_row(form.newTechnicalSkills) }}
            {{ form_row(form.functionalExperiences, {row_attr: {class: 'mt-8 mb-5'}}) }}
            {{ form_row(form.newFunctionalExperiences) }}
        </twig:FormSection>
    </div>
    {{ include('common/_form_actions.html.twig', {submit_test: 'team-member-submit', cancel_path: path('app_team_index')}) }}
{{ form_end(form) }}
