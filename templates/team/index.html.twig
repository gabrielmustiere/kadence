{% extends 'base.html.twig' %}

{% block title %}Équipe · Kadence{% endblock %}

{% block body %}
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="font-display text-2xl font-bold tracking-tight text-heading sm:text-3xl">Équipe</h1>
            <p class="mt-1 text-sm text-body">Qui a accès à Kadence, et avec quel rôle.</p>
        </div>
        <twig:Button as="a" href="{{ path('app_team_new') }}" data-test="team-new">
            <twig:ux:icon name="tabler:user-plus" class="size-4 me-1.5"/>
            Inscrire une personne
        </twig:Button>
    </div>

    {% set categories = enum('App\\Enum\\Type\\TagCategory') %}
    {{ form_start(filter_form, {attr: {class: 'mb-4 flex flex-wrap items-end gap-x-4 gap-y-2', 'data-test': 'team-filter'}}) }}
        {% for field in filter_form %}
            <div class="w-full sm:w-48">{{ form_row(field, {row_attr: {class: 'mb-0'}}) }}</div>
        {% endfor %}
        <div class="flex items-center gap-3 pb-0.5">
            <twig:Button type="submit" size="sm" variant="outline" data-test="team-filter-submit">Filtrer</twig:Button>
            {% if filtered %}
                <a href="{{ path('app_team_index') }}" class="text-sm text-body underline hover:no-underline" data-test="team-filter-reset">Tout afficher</a>
            {% endif %}
        </div>
    {{ form_end(filter_form) }}

    <div class="overflow-x-auto rounded-base border border-default">
        <twig:Table data-test="team-table">
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head class="px-4">Personne</twig:Table:Head>
                    <twig:Table:Head class="px-4">Rôle</twig:Table:Head>
                    <twig:Table:Head class="px-4">Équipe</twig:Table:Head>
                    <twig:Table:Head class="px-4 whitespace-nowrap">Compétences et expériences</twig:Table:Head>
                    <twig:Table:Head class="px-4">Manager</twig:Table:Head>
                    <twig:Table:Head class="px-4"><span class="sr-only">Actions</span></twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for member in members %}
                    {% set token = csrf_token('team-member-' ~ member.id) %}
                    {% set skills = member.tagsOf(categories.TechnicalSkill) %}
                    {% set experiences = member.tagsOf(categories.FunctionalExperience) %}
                    <twig:Table:Row data-test="team-member-row" data-email="{{ member.email }}">
                        <twig:Table:Cell class="px-4">
                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_team_edit', {id: member.id}) }}" class="whitespace-nowrap font-medium hover:underline {{ member.active ? 'text-heading' : 'text-body' }}">{{ member.firstName }} {{ member.lastName }}</a>
                                {% if not member.active %}
                                    <twig:Badge variant="alternative" border="bordered" data-test="member-status">Désactivée</twig:Badge>
                                {% endif %}
                            </div>
                            <span class="block text-xs text-body">{{ member.email }}</span>
                        </twig:Table:Cell>
                        <twig:Table:Cell class="px-4 text-heading" data-test="member-role">{{ member.role.label }}</twig:Table:Cell>
                        <twig:Table:Cell class="px-4" data-test="member-team-type">
                            {% if member.teamType %}
                                <twig:Badge variant="brand" data-test="member-tag">{{ member.teamType.label }}</twig:Badge>
                            {% else %}
                                <span class="text-body" aria-label="Aucune">—</span>
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell class="px-4">
                            <div class="space-y-1.5" data-test="member-tags">
                                {% for group in [
                                    {tags: skills, icon: 'tabler:code', label: categories.TechnicalSkill.pluralLabel, variant: 'gray', border: 'none'},
                                    {tags: experiences, icon: 'tabler:briefcase', label: categories.FunctionalExperience.pluralLabel, variant: 'alternative', border: 'bordered'},
                                ] %}
                                    {% if group.tags is not empty %}
                                        <div class="flex items-start gap-2">
                                            <span class="mt-0.5 shrink-0 text-body" title="{{ group.label }}">
                                                <twig:ux:icon name="{{ group.icon }}" class="size-4" aria-hidden="true"/>
                                                <span class="sr-only">{{ group.label }} :</span>
                                            </span>
                                            <div class="flex flex-wrap gap-1">
                                                {% for tag in group.tags %}
                                                    <twig:Badge :variant="group.variant" :border="group.border" data-test="member-tag">{{ tag.label }}</twig:Badge>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                {% if skills is empty and experiences is empty %}
                                    <span class="text-body" aria-label="Aucune">—</span>
                                {% endif %}
                            </div>
                        </twig:Table:Cell>
                        <twig:Table:Cell class="px-4 whitespace-nowrap" data-test="member-manager">
                            {% if member.manager %}{{ member.manager.firstName }} {{ member.manager.lastName }}{% else %}<span class="text-body" aria-label="Aucun">—</span>{% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell class="px-4">
                            <div class="flex justify-end gap-1">
                                <twig:Button as="a" size="icon-xs" variant="outline" class="text-heading" href="{{ path('app_team_edit', {id: member.id}) }}" data-tooltip="Modifier" aria-label="Modifier {{ member.firstName }} {{ member.lastName }}" data-test="member-edit">
                                    <twig:ux:icon name="tabler:pencil" class="size-4"/>
                                </twig:Button>

                                {% if member.active %}
                                    <twig:Modal id="reset-password-{{ member.id }}">
                                        <twig:Modal:Trigger>
                                            <twig:Button size="icon-xs" variant="outline" class="text-heading" data-tooltip="Nouveau mot de passe provisoire" aria-label="Nouveau mot de passe provisoire pour {{ member.firstName }} {{ member.lastName }}" data-test="member-reset-password" {{ ...modal_trigger_attrs }}>
                                                <twig:ux:icon name="tabler:key" class="size-4"/>
                                            </twig:Button>
                                        </twig:Modal:Trigger>
                                        <twig:Modal:Content>
                                            <twig:Modal:Header>
                                                <twig:Modal:Title>Nouveau mot de passe provisoire</twig:Modal:Title>
                                            </twig:Modal:Header>
                                            <twig:Modal:Body>
                                                <p class="text-body">L'actuel mot de passe de {{ member.firstName }} {{ member.lastName }} cessera immédiatement de fonctionner. Un mot de passe provisoire vous sera affiché une seule fois.</p>
                                            </twig:Modal:Body>
                                            <twig:Modal:Footer>
                                                <form method="post" action="{{ path('app_team_reset_password', {id: member.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <twig:Button type="submit" data-test="member-reset-password-confirm">Générer</twig:Button>
                                                </form>
                                                <twig:Modal:Close>
                                                    <twig:Button variant="outline" {{ ...modal_close_attrs }}>Annuler</twig:Button>
                                                </twig:Modal:Close>
                                            </twig:Modal:Footer>
                                        </twig:Modal:Content>
                                    </twig:Modal>

                                    <twig:Modal id="deactivate-{{ member.id }}">
                                        <twig:Modal:Trigger>
                                            <twig:Button size="icon-xs" variant="outline" class="text-danger hover:border-danger hover:bg-danger-soft hover:text-danger" data-tooltip="Désactiver" aria-label="Désactiver {{ member.firstName }} {{ member.lastName }}" data-test="member-deactivate" {{ ...modal_trigger_attrs }}>
                                                <twig:ux:icon name="tabler:user-off" class="size-4"/>
                                            </twig:Button>
                                        </twig:Modal:Trigger>
                                        <twig:Modal:Content>
                                            <twig:Modal:Header>
                                                <twig:Modal:Title>Désactiver {{ member.firstName }} {{ member.lastName }} ?</twig:Modal:Title>
                                            </twig:Modal:Header>
                                            <twig:Modal:Body>
                                                <p class="text-body">La personne ne pourra plus se connecter et sa session en cours sera coupée. Son historique est conservé, et vous pourrez la réactiver à tout moment.</p>
                                            </twig:Modal:Body>
                                            <twig:Modal:Footer>
                                                <form method="post" action="{{ path('app_team_deactivate', {id: member.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ token }}">
                                                    <twig:Button type="submit" variant="danger" data-test="member-deactivate-confirm">Désactiver</twig:Button>
                                                </form>
                                                <twig:Modal:Close>
                                                    <twig:Button variant="outline" data-test="member-deactivate-cancel" {{ ...modal_close_attrs }}>Annuler</twig:Button>
                                                </twig:Modal:Close>
                                            </twig:Modal:Footer>
                                        </twig:Modal:Content>
                                    </twig:Modal>
                                {% else %}
                                    <form method="post" action="{{ path('app_team_reactivate', {id: member.id}) }}">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <twig:Button type="submit" size="icon-xs" variant="outline" class="text-success hover:border-success hover:bg-success-soft hover:text-success" data-tooltip="Réactiver" aria-label="Réactiver {{ member.firstName }} {{ member.lastName }}" data-test="member-reactivate">
                                            <twig:ux:icon name="tabler:user-check" class="size-4"/>
                                        </twig:Button>
                                    </form>
                                {% endif %}
                            </div>
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="6" class="text-center text-body" data-test="team-empty">Personne ne correspond à ces filtres.</twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </div>
{% endblock %}
