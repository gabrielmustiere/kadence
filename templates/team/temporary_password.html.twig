{% extends 'base.html.twig' %}

{% block title %}Mot de passe provisoire · Kadence{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title as="h1">Mot de passe provisoire de {{ member.firstName }} {{ member.lastName }}</twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content class="space-y-6">
                <twig:Alert variant="warning" border="bordered">
                    <twig:ux:icon name="tabler:alert-triangle"/>
                    <div>
                        <twig:Alert:Title>Ce mot de passe ne sera plus jamais affiché.</twig:Alert:Title>
                        <twig:Alert:Description>Notez-le et transmettez-le à la personne. Elle devra le remplacer par le sien à sa première connexion.</twig:Alert:Description>
                    </div>
                </twig:Alert>

                <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <dt class="text-sm text-body">Identifiant</dt>
                        <dd class="mt-1 font-mono text-heading" data-test="temporary-password-email">{{ member.email }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm text-body">Mot de passe provisoire</dt>
                        <dd class="mt-1 select-all font-mono text-xl tracking-wider text-heading" data-test="temporary-password">{{ temporary_password }}</dd>
                    </div>
                </dl>

                <twig:Button as="a" href="{{ path('app_team_index') }}" data-test="temporary-password-done">C'est noté, retour à l'équipe</twig:Button>
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
