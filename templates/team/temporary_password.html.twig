{% extends 'base.html.twig' %}

{% block title %}Mot de passe provisoire · Kadence{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <twig:PageHeader title="Mot de passe provisoire de {{ member.firstName }} {{ member.lastName }}"/>
        <twig:Card class="space-y-6">
            <twig:Alert variant="warning" border="bordered">
                <twig:ux:icon name="tabler:alert-triangle"/>
                <div>
                    <twig:Alert:Title>Ce mot de passe ne sera plus jamais affiché.</twig:Alert:Title>
                    <twig:Alert:Description>Notez-le et transmettez-le à la personne. Elle devra le remplacer par le sien à sa première connexion.</twig:Alert:Description>
                </div>
            </twig:Alert>

            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-default bg-neutral-secondary-soft p-4">
                    <dt class="eyebrow text-body-subtle">Identifiant</dt>
                    <dd class="mt-2 break-all font-mono text-sm text-heading" data-test="temporary-password-email">{{ member.email }}</dd>
                </div>
                <div class="rounded-xl border border-brand-subtle bg-brand-softer p-4">
                    <dt class="eyebrow text-fg-brand">Mot de passe provisoire</dt>
                    <dd class="mt-2 select-all font-mono text-xl tracking-wider text-heading" data-test="temporary-password">{{ temporary_password }}</dd>
                </div>
            </dl>

            <twig:Button as="a" href="{{ path('app_team_index') }}" data-test="temporary-password-done">
                C'est noté, retour à l'équipe
                <twig:ux:icon name="tabler:arrow-right" class="size-4"/>
            </twig:Button>
        </twig:Card>
    </div>
{% endblock %}
