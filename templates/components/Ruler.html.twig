{# @prop entered int The quarters entered #}
{# @prop remaining int The quarters left of the estimates in force #}
{# @prop overrun int The quarters entered beyond the estimates #}
{# @prop estimate int The quarters estimated #}
{# @prop scale int|null The quarters the full width stands for, shared by the rulers of a table so that they compare; their own span by default #}
{# @prop projected int|null The quarters the work is projected to cost once done, marked on the ruler #}
{# @prop size string `sm` in a table row, `lg` at the head of a page, with its graduation #}
{# @block content On a `lg` ruler, its legend, set on the line of its unit and shown even when there is nothing to draw #}
{%- props entered = 0, remaining = 0, overrun = 0, estimate = 0, scale = null, projected = null, size = 'sm' -%}
{%- set done = max(entered - overrun, 0) -%}
{%- set span = max(scale ?? 0, done + remaining + overrun, estimate, projected ?? 0) -%}
{%- if span > 0 or size == 'lg' -%}
    {%- set days = span / 4 -%}
    {%- set cell = ([1, 5, 10, 20, 50, 100]|filter(cell => days / cell <= (size == 'lg' ? 100 : 24))|first) ?: 100 -%}
    {%- set narrowCell = ([1, 5, 10, 20, 50, 100]|filter(cell => days / cell <= 30)|first) ?: 100 -%}
    {%- set pct = span > 0 ? 100 / span : 0 -%}
    {%- set cells = size == 'lg'
        ? '--ruler-cells-wide: ' ~ max(days / cell, 1)|round(4) ~ '; --ruler-cells-narrow: ' ~ max(days / narrowCell, 1)|round(4)
        : '--ruler-cells: ' ~ max(days / cell, 1)|round(4) -%}
    <div {{ attributes.defaults({class: 'ruler ruler-' ~ size, style: cells}) }}>
        {%- if span > 0 -%}
            <div class="ruler-track" aria-hidden="true">
                {%- if done > 0 %}<span class="ruler-done" style="width: {{ (done * pct)|round(3) }}%"></span>{% endif -%}
                {%- if remaining > 0 %}<span class="ruler-rest" style="left: {{ (done * pct)|round(3) }}%; width: {{ (remaining * pct)|round(3) }}%"></span>{% endif -%}
                {%- if overrun > 0 %}<span class="ruler-over" style="left: {{ ((done + remaining) * pct)|round(3) }}%; width: {{ (overrun * pct)|round(3) }}%"></span>{% endif -%}
                {%- if overrun > 0 and estimate > 0 %}<span class="ruler-mark" style="left: {{ (estimate * pct)|round(3) }}%"></span>{% endif -%}
                {%- if projected %}<span class="ruler-projected" style="left: {{ (projected * pct)|round(3) }}%"></span>{% endif -%}
            </div>
        {%- endif -%}
        {%- if size == 'lg' -%}
            {%- if span > 0 -%}
                {%- set step = ([1, 2, 5, 10, 20, 25, 50, 100, 200, 500]|filter(step => days / step <= 10)|first) ?: 500 -%}
                <div class="ruler-graduation" aria-hidden="true">
                    {%- for day in range(0, days|round(0, 'floor'), step) %}
                        <span style="left: {{ (day * 4 * pct)|round(3) }}%">{{ day }}</span>
                    {%- endfor %}
                </div>
            {%- endif -%}
            <div class="{{ span > 0 ? 'mt-3 ' }}flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
                {%- block content %}{% endblock -%}
                {%- if span > 0 %}
                    <p class="ms-auto text-xs text-body-subtle" aria-hidden="true">
                        Jours ouvrés, une case
                        <span class="sm:hidden">{{ narrowCell == 1 ? 'par jour' : 'pour ' ~ narrowCell ~ ' jours' }}</span>
                        <span class="max-sm:hidden">{{ cell == 1 ? 'par jour' : 'pour ' ~ cell ~ ' jours' }}</span>
                    </p>
                {%- endif %}
            </div>
        {%- endif -%}
    </div>
{%- endif -%}
