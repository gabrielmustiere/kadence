{# @block content The card content, typically includes `Card:Content` with `Card:Header`, and/or `Card:Footer` #}
<div
    class="{{ ('block rounded-card border border-default bg-surface p-6 text-body shadow-card ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
