{# @prop href string The link target #}
{# @prop icon string The icon name, e.g. `tabler:folders` #}
{# @prop active bool Whether the link leads to the page being shown. Defaults to `false` #}
{# @block content The link label #}
{%- props href, icon, active = false -%}
<a href="{{ href }}"
   class="{{ ('group flex items-center p-2 text-base font-medium rounded-lg ' ~ (active ? 'bg-brand-softer font-semibold text-fg-brand-strong' : 'text-gray-900 hover:bg-gray-100 dark:text-white dark:hover:bg-gray-700') ~ ' ' ~ attributes.render('class'))|tailwind_merge }}"
   {% if active %}aria-current="page"{% endif %}
   {{ attributes }}
>
    <twig:ux:icon name="{{ icon }}" class="w-6 h-6 transition duration-75 {{ active ? 'text-fg-brand-strong' : 'text-gray-500 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white' }}"/>
    <span class="ml-3">{%- block content %}{% endblock -%}</span>
</a>
