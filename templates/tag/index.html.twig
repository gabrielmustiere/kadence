{% extends 'base.html.twig' %}

{% block title %}Tags · Kadence{% endblock %}

{% block body %}
    <twig:PageHeader title="Tags" description="Le vocabulaire qui décrit l'équipe : compétences techniques, expériences fonctionnelles et types d'équipe, à attribuer depuis la fiche de chaque personne."/>

    <twig:Card class="mb-8" data-test="tag-add">
        <twig:Card:Header>
            <twig:Card:Title as="h2">Ajouter un tag</twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form, {attr: {'data-test': 'tag-form'}}) }}
                {{ form_row(form.category) }}
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <div class="w-full sm:max-w-md">{{ form_row(form.label, {row_attr: {class: 'mb-0'}}) }}</div>
                    <twig:Button type="submit" class="shrink-0" data-test="tag-submit">
                        <twig:ux:icon name="tabler:plus" class="size-4"/>
                        Ajouter
                    </twig:Button>
                </div>
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {% for item in categories %}
            <section class="flex flex-col overflow-hidden rounded-card border border-default bg-surface shadow-card" data-test="tag-category" data-category="{{ item.category.value }}">
                <header class="flex items-center justify-between gap-3 border-b border-default bg-neutral-secondary-soft px-5 py-3.5">
                    <h2 class="text-[15px] font-semibold tracking-tight text-heading">{{ item.category.pluralLabel }}</h2>
                    <span class="rounded-full bg-neutral-tertiary px-2 py-0.5 text-xs tabular-nums text-body">{{ item.tags|length }}</span>
                </header>
                {% if item.tags is empty %}
                    <p class="px-5 py-8 text-center text-sm text-body" data-test="tag-empty">Aucun tag pour l'instant.</p>
                {% else %}
                    <ul class="divide-y divide-default-subtle text-sm">
                        {% for tag in item.tags %}
                            {% set count = holders[tag.id] ?? 0 %}
                            <li class="group flex items-center justify-between gap-3 px-5 py-2.5 transition-colors hover:bg-neutral-secondary-soft" data-test="tag-row" data-label="{{ tag.label }}">
                                <span class="min-w-0">
                                    <span class="font-medium text-heading" data-test="tag-row-label">{{ tag.label }}</span>
                                    <span class="block text-xs text-body-subtle" data-test="tag-holders" data-count="{{ count }}">{{ count }} {{ count > 1 ? 'personnes' : 'personne' }}</span>
                                </span>
                                <span class="flex shrink-0 items-center gap-0.5">
                                    <twig:Button as="a" size="icon-xs" variant="ghost" class="text-body-subtle" href="{{ path('app_tag_edit', {id: tag.id}) }}" data-tooltip="Renommer" aria-label="Renommer « {{ tag.label }} »" data-test="tag-rename">
                                        <twig:ux:icon name="tabler:pencil" class="size-4"/>
                                    </twig:Button>
                                    <twig:Modal id="delete-tag-{{ tag.id }}">
                                        <twig:Modal:Trigger>
                                            <twig:Button size="icon-xs" variant="ghost" class="text-body-subtle hover:bg-danger-soft hover:text-fg-danger" data-tooltip="Supprimer" aria-label="Supprimer « {{ tag.label }} »" data-test="tag-delete" {{ ...modal_trigger_attrs }}>
                                                <twig:ux:icon name="tabler:trash" class="size-4"/>
                                            </twig:Button>
                                        </twig:Modal:Trigger>
                                        <twig:Modal:Content>
                                            <twig:Modal:Header>
                                                <twig:Modal:Title>Supprimer le tag « {{ tag.label }} » ?</twig:Modal:Title>
                                            </twig:Modal:Header>
                                            <twig:Modal:Body>
                                                <p class="text-body" data-test="tag-delete-holders">
                                                    {% if count > 0 %}
                                                        Il est porté par {{ count }} {{ count > 1 ? 'personnes' : 'personne' }} : il sera retiré de {{ count > 1 ? 'leur' : 'son' }} profil. La suppression ne se défait pas.
                                                    {% else %}
                                                        Personne ne le porte. La suppression ne se défait pas.
                                                    {% endif %}
                                                </p>
                                            </twig:Modal:Body>
                                            <twig:Modal:Footer>
                                                <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('tag-' ~ tag.id) }}">
                                                    <twig:Button type="submit" variant="danger" data-test="tag-delete-confirm">Supprimer</twig:Button>
                                                </form>
                                                <twig:Modal:Close>
                                                    <twig:Button variant="outline" data-test="tag-delete-cancel" {{ ...modal_close_attrs }}>Annuler</twig:Button>
                                                </twig:Modal:Close>
                                            </twig:Modal:Footer>
                                        </twig:Modal:Content>
                                    </twig:Modal>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endfor %}
    </div>
{% endblock %}
