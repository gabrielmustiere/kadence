{% extends 'base.html.twig' %}

{% block title %}Renommer « {{ tag.label }} » · Kadence{% endblock %}

{% block body %}
    <twig:PageHeader title="Renommer « {{ tag.label }} »" :eyebrow="tag.category.label" :back="path('app_tag_index')" backLabel="Tags"
                     description="Le nouveau libellé s'affiche aussitôt sur toutes les personnes qui portent ce tag."/>
    <twig:Card class="max-w-2xl">
        {{ form_start(form, {attr: {'data-test': 'tag-form'}}) }}
            {{ form_row(form.label) }}
            {{ include('common/_form_actions.html.twig', {submit_label: 'Renommer', submit_test: 'tag-submit', cancel_path: path('app_tag_index')}) }}
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
