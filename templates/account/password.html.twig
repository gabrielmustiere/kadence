{% extends forced ? 'security.html.twig' : 'base.html.twig' %}

{% block title %}{{ forced ? 'Choisir votre mot de passe' : 'Changer mon mot de passe' }} · Kadence{% endblock %}

{% block body %}
    <div{% if forced %} class="flex min-h-screen items-center justify-center px-4 py-10"{% endif %}>
        {% if not forced %}
            {% set categories = enum('App\\Enum\\Type\\TagCategory') %}
            <twig:Card class="mb-6 w-full" data-test="account-profile">
                <twig:Card:Header>
                    <twig:Card:Title as="h2">Mon profil</twig:Card:Title>
                    <p class="mt-2 text-sm text-body">Ce que Kadence dit de vous, tenu par la direction. Il aide les leads à composer l'équipe des feuilles.</p>
                </twig:Card:Header>
                <twig:Card:Content>
                    <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-[auto_1fr]">
                        {% for category in categories.cases() %}
                            <dt class="font-medium text-heading">{{ category.allowsMany ? category.pluralLabel : category.label }}</dt>
                            <dd class="flex flex-wrap gap-1" data-test="account-tags-{{ category.value }}">
                                {% for tag in app.user.tagsOf(category) %}
                                    <twig:Badge variant="gray" data-test="account-tag">{{ tag.label }}</twig:Badge>
                                {% else %}
                                    <span class="text-body">{{ category.allowsMany ? 'Aucune' : 'Aucun' }}</span>
                                {% endfor %}
                            </dd>
                        {% endfor %}
                        <dt class="font-medium text-heading">Manager</dt>
                        <dd data-test="account-manager">
                            {% if app.user.manager %}
                                <span class="text-heading">{{ app.user.manager.firstName }} {{ app.user.manager.lastName }}</span>
                            {% else %}
                                <span class="text-body">Aucun</span>
                            {% endif %}
                        </dd>
                    </dl>
                </twig:Card:Content>
            </twig:Card>
        {% endif %}
        <twig:Card :class="forced ? 'w-full max-w-lg' : 'w-full'">
            <twig:Card:Header>
                <twig:Card:Title as="h1">{{ forced ? 'Choisissez votre mot de passe' : 'Changer mon mot de passe' }}</twig:Card:Title>
                <p class="mt-2 text-sm text-body">
                    {% if forced %}
                        Vous vous êtes connecté avec un mot de passe provisoire. Choisissez le vôtre pour accéder à Kadence : personne d'autre ne le connaîtra.
                    {% else %}
                        Confirmez votre mot de passe actuel, puis choisissez-en un nouveau.
                    {% endif %}
                </p>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(form, {attr: {'data-test': 'change-password-form'}}) }}
                    {{ form_widget(form) }}
                    <div class="mt-6 flex items-center justify-between gap-3">
                        <twig:Button type="submit" data-test="change-password-submit">Enregistrer le mot de passe</twig:Button>
                        {% if forced %}
                            <a href="{{ path('app_logout') }}" class="text-sm text-body underline hover:no-underline">Se déconnecter</a>
                        {% endif %}
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
