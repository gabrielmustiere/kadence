{% extends forced ? 'security.html.twig' : 'base.html.twig' %}

{% block title %}{{ forced ? 'Choisir votre mot de passe' : 'Changer mon mot de passe' }} · Kadence{% endblock %}

{% block body %}
    <div class="{{ forced ? 'flex min-h-screen items-center justify-center px-4 py-10' : 'mx-auto max-w-lg' }}">
        <twig:Card class="w-full max-w-lg">
            <twig:Card:Header>
                <twig:Card:Title as="h1">{{ forced ? 'Choisissez votre mot de passe' : 'Changer mon mot de passe' }}</twig:Card:Title>
                <p class="mt-2 text-sm text-body">
                    {% if forced %}
                        Vous vous êtes connecté avec un mot de passe provisoire. Choisissez le vôtre pour accéder à Kadence : personne d'autre ne le connaîtra.
                    {% else %}
                        Confirmez votre mot de passe actuel, puis choisissez-en un nouveau.
                    {% endif %}
                </p>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(form, {attr: {'data-test': 'change-password-form'}}) }}
                    {{ form_widget(form) }}
                    <div class="mt-6 flex items-center justify-between gap-3">
                        <twig:Button type="submit" data-test="change-password-submit">Enregistrer le mot de passe</twig:Button>
                        {% if forced %}
                            <a href="{{ path('app_logout') }}" class="text-sm text-body underline hover:no-underline">Se déconnecter</a>
                        {% endif %}
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
