{% extends forced ? 'security.html.twig' : 'base.html.twig' %}

{% block title %}{{ forced ? 'Choisir votre mot de passe' : 'Changer mon mot de passe' }} · Kadence{% endblock %}

{% block body %}
    {% if forced %}
        <div class="flex min-h-screen flex-col items-center justify-center gap-8 px-4 py-10">
            <div class="flex items-center gap-2.5">
                <twig:Logo class="size-8"/>
                <span class="text-lg font-semibold tracking-tight text-heading">Kadence</span>
            </div>
            <twig:Card class="w-full max-w-lg p-8">
                <h1 class="font-display text-[2rem] leading-tight text-heading">Choisissez votre mot de passe</h1>
                <p class="mt-2 text-sm leading-relaxed text-body">
                    Vous vous êtes connecté avec un mot de passe provisoire. Choisissez le vôtre pour accéder à Kadence : personne d'autre ne le connaîtra.
                </p>
                <div class="mt-6">
                    {{ include('account/_password_form.html.twig') }}
                </div>
            </twig:Card>
        </div>
    {% else %}
        <twig:PageHeader title="Changer mon mot de passe" description="Confirmez votre mot de passe actuel, puis choisissez-en un nouveau."/>

        <div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
            <twig:Card>
                {{ include('account/_password_form.html.twig') }}
            </twig:Card>
            {% set categories = enum('App\\Enum\\Type\\TagCategory') %}
            <twig:Card data-test="account-profile">
                <div class="flex items-center gap-4 border-b border-default pb-5">
                    <twig:Avatar :user="app.user" size="lg" tone="ink"/>
                    <div class="min-w-0">
                        <h2 class="text-[15px] font-semibold tracking-tight text-heading">Mon profil</h2>
                        <p class="mt-0.5 text-[13px] leading-relaxed text-body">Ce que Kadence dit de vous, tenu par la direction. Il aide les leads à composer l'équipe des feuilles.</p>
                    </div>
                </div>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-4 pt-5 text-sm sm:grid-cols-[10rem_1fr]">
                    {% for category in categories.cases() %}
                        <dt class="eyebrow pt-1 text-body-subtle">{{ category.allowsMany ? category.pluralLabel : category.label }}</dt>
                        <dd class="flex flex-wrap gap-1.5" data-test="account-tags-{{ category.value }}">
                            {% for tag in app.user.tagsOf(category) %}
                                <twig:Badge variant="gray" size="lg" data-test="account-tag">{{ tag.label }}</twig:Badge>
                            {% else %}
                                <span class="text-body-subtle">{{ category.allowsMany ? 'Aucune' : 'Aucun' }}</span>
                            {% endfor %}
                        </dd>
                    {% endfor %}
                    <dt class="eyebrow pt-1 text-body-subtle">Manager</dt>
                    <dd data-test="account-manager">
                        {% if app.user.manager %}
                            <span class="inline-flex items-center gap-2 text-heading">
                                <twig:Avatar :user="app.user.manager" size="sm"/>
                                {{ app.user.manager.firstName }} {{ app.user.manager.lastName }}
                            </span>
                        {% else %}
                            <span class="text-body-subtle">Aucun</span>
                        {% endif %}
                    </dd>
                </dl>
            </twig:Card>
        </div>
    {% endif %}
{% endblock %}
