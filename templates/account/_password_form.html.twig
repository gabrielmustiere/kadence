{{ form_start(form, {attr: {'data-test': 'change-password-form'}}) }}
    {{ form_widget(form) }}
    <div class="mt-2 flex items-center justify-between gap-3">
        <twig:Button type="submit" data-test="change-password-submit">Enregistrer le mot de passe</twig:Button>
        {% if forced %}
            <a href="{{ path('app_logout') }}" class="text-sm text-body underline decoration-default-strong underline-offset-4 hover:text-heading">Se déconnecter</a>
        {% endif %}
    </div>
{{ form_end(form) }}
