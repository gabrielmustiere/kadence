{% extends 'base.html.twig' %}

{% block title %}Accueil · Kadence{% endblock %}

{% block body %}
    {% set tooltip_actions = 'pointerover->roadmap-tooltip#show pointerout->roadmap-tooltip#leave focusin->roadmap-tooltip#show focusout->roadmap-tooltip#leave scroll@window->roadmap-tooltip#hide keydown.esc@window->roadmap-tooltip#hide turbo:before-cache@document->roadmap-tooltip#hide' %}
    {% set status_variants = {pending: 'warning', approved: 'success', refused: 'danger', cancelled: 'gray'} %}
    {% set link_class = 'font-medium text-heading decoration-default-strong underline-offset-4 hover:underline' %}

    <twig:PageHeader title="Accueil">
        <twig:block name="description">
            <p class="mt-2.5 max-w-3xl text-[15px] leading-relaxed text-body" data-test="home-greeting">
                Bonjour {{ app.user.firstName }}. {{ agenda.empty ? 'Rien ne vous attend pour l\'instant.' : 'Voici ce qui vous attend.' }}
            </p>
        </twig:block>
    </twig:PageHeader>

    {% if agenda.empty %}
        <twig:EmptyState icon="tabler:circle-check" class="max-w-4xl" data-test="home-empty">
            <p>Vos journées sont saisies, aucune demande n'attend de décision et vos lots suivent leur cours.</p>
            <twig:Button as="a" variant="outline" size="sm" href="{{ path('app_timesheet') }}" class="mt-4" data-test="home-empty-timesheet">
                <twig:ux:icon name="tabler:calendar-week" class="size-4"/>
                Ouvrir Ma semaine
            </twig:Button>
        </twig:EmptyState>
    {% else %}
        <div class="max-w-4xl space-y-6">
            {% if agenda.forgottenDays is not empty %}
                {% embed 'page/_section.html.twig' with {key: 'timesheet', title: 'Ma saisie', description: 'Journées incomplètes de cette semaine et de la précédente.', count: agenda.forgottenDays|length} %}
                    {% block items %}
                        {% for day in agenda.forgottenDays %}
                            <li class="flex items-center justify-between gap-4 px-5 py-3" data-test="home-forgotten-day" data-day="{{ day.date|date('Y-m-d') }}">
                                <a href="{{ path('app_timesheet_week', {week: day.date|date('o-\\WW')}) }}" class="{{ link_class }}">{{ day.date|weekday }} {{ day.date|date('d/m/Y') }}</a>
                                <span class="tabular-nums text-body">{{ day.quarters|days }} saisi sur {{ day.capQuarters|days }}</span>
                            </li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if agenda.toDecide is not empty %}
                {% embed 'page/_section.html.twig' with {key: 'to-decide', title: 'À valider', description: 'Demandes de congé qui attendent votre décision.', count: agenda.toDecide|length} %}
                    {% block items %}
                        {% for request in agenda.toDecide %}
                            <li class="flex flex-col gap-1 px-5 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4" data-test="home-to-decide" data-id="{{ request.id }}">
                                <a href="{{ path('app_time_off_inbox') }}" class="{{ link_class }}">{{ request.user.firstName }} {{ request.user.lastName }}</a>
                                <span class="tabular-nums text-body">{{ request.type.label }} · {{ include('time_off/_period.html.twig') }}</span>
                            </li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if agenda.myLeaves is not empty %}
                {% embed 'page/_section.html.twig' with {key: 'my-lots', title: 'Mes lots', description: 'Les lots dont vous êtes responsable et qui demandent une action.', count: agenda.myLeaves|length} %}
                    {% block items %}
                        {% for row in agenda.myLeaves %}
                            <li class="px-5 py-3" data-test="home-my-lot" data-lot="{{ row.lot.id }}" data-controller="roadmap-tooltip" data-action="{{ tooltip_actions }}">
                                <a href="{{ path('app_project_show', {id: row.project.id}) }}" class="text-[13px] text-body underline decoration-default-medium underline-offset-4 hover:text-heading hover:decoration-default-strong" data-test="home-my-lot-link">{{ row.project.title }}</a>
                                <p class="mt-0.5 font-semibold text-heading">{{ row.leafPath }}</p>
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    {% for signal in row.signals %}
                                        {{ include('roadmap/_signal.html.twig', {prefix: 'home-lot-signal'}) }}
                                    {% endfor %}
                                </div>
                                {{ include('roadmap/_signal_tooltips.html.twig', {prefix: 'home-lot-signal'}) }}
                            </li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if agenda.watchedProjects is not empty %}
                {% embed 'page/_section.html.twig' with {key: 'watched-projects', title: 'Projets à surveiller', description: 'Fin inconnue, ou un lot qui demande qu\'on s\'en occupe.', count: agenda.watchedProjects|length} %}
                    {% block items %}
                        {% for watched in agenda.watchedProjects %}
                            {% set row = watched.row %}
                            <li class="flex flex-col gap-2 px-5 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4" data-test="home-watched-project" data-project="{{ row.project.id }}" data-controller="roadmap-tooltip" data-action="{{ tooltip_actions }}">
                                <div class="min-w-0">
                                    <a href="{{ path('app_project_show', {id: row.project.id}) }}" class="{{ link_class }}" data-test="home-watched-project-link">{{ row.project.title }}</a>
                                    {% if watched.signals is not empty %}
                                        <div class="mt-2 flex flex-wrap gap-1.5">
                                            {% for signal in watched.signals %}
                                                {{ include('roadmap/_signal.html.twig', {prefix: 'home-project-signal'}) }}
                                            {% endfor %}
                                        </div>
                                        {{ include('roadmap/_signal_tooltips.html.twig', {prefix: 'home-project-signal', signals: watched.signals}) }}
                                    {% endif %}
                                </div>
                                <span class="shrink-0 tabular-nums text-body" data-test="home-watched-project-end">
                                    {%- if row.endUnknown %}Fin inconnue{% elseif row.end %}Fin le {{ row.end|date('d/m/Y') }}{% endif -%}
                                </span>
                            </li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if agenda.myRequests is not empty %}
                {% embed 'page/_section.html.twig' with {key: 'my-time-off', title: 'Mes congés', description: 'Vos demandes en attente, et celles décidées ces sept derniers jours.', count: agenda.myRequests|length} %}
                    {% block items %}
                        {% for request in agenda.myRequests %}
                            <li class="flex flex-col gap-1 px-5 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4" data-test="home-my-request" data-id="{{ request.id }}" data-status="{{ request.status.value }}">
                                <a href="{{ path('app_time_off_index') }}" class="{{ link_class }} tabular-nums">{{ request.type.label }} · {{ include('time_off/_period.html.twig') }}</a>
                                <twig:Badge variant="{{ status_variants[request.status.value] }}" class="self-start sm:self-auto">{{ request.status.label }}</twig:Badge>
                            </li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
