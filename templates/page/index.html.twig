{% extends 'base.html.twig' %}

{% block title %}Tableau de bord · Kadence{% endblock %}

{% block body %}
    <div class="mb-8">
        <h1 class="font-display text-2xl font-bold tracking-tight text-heading sm:text-3xl">Tableau de bord</h1>
        <p class="mt-1 text-sm text-body" data-test="home-greeting">
            Bonjour {{ app.user.firstName }}. Suivez la charge, l'avancement et les dates de livraison de l'équipe.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {{ _self.shortcut(path('app_project_index'), 'tabler:folders', 'Projets', 'Découper les projets en lots et sous-lots, estimer et confier chaque partie.', 'home-projects') }}
        {% if is_granted('ROLE_DIRECTION') %}
            {{ _self.shortcut(path('app_team_index'), 'tabler:users', 'Équipe', 'Inscrire les personnes, gérer leurs rôles et leurs accès.', 'home-team') }}
        {% endif %}
        {{ _self.shortcut(path('app_account_password'), 'tabler:user', 'Mon compte', 'Changer votre mot de passe.', 'home-account') }}
    </div>
{% endblock %}

{% macro shortcut(href, icon, title, description, test_id) %}
    <a href="{{ href }}" data-test="{{ test_id }}" class="group block">
        <twig:Card class="h-full transition group-hover:bg-neutral-secondary-soft">
            <div class="flex items-start gap-4">
                <span class="grid size-10 shrink-0 place-items-center rounded-base bg-neutral-secondary-medium text-heading">
                    <twig:ux:icon name="{{ icon }}" class="size-5"/>
                </span>
                <div class="min-w-0 flex-1">
                    <p class="font-display text-base font-semibold text-heading">{{ title }}</p>
                    <p class="mt-1 text-sm text-body">{{ description }}</p>
                </div>
                <twig:ux:icon name="tabler:arrow-right" class="size-5 shrink-0 text-body transition group-hover:translate-x-0.5"/>
            </div>
        </twig:Card>
    </a>
{% endmacro %}
