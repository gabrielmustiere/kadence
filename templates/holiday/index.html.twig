{% extends 'base.html.twig' %}

{% block title %}Jours fériés {{ year }} · Kadence{% endblock %}

{% block body %}
    <twig:PageHeader title="Jours fériés {{ year }}" :headingAttrs="{'data-test': 'holiday-year', 'data-year': year}"
                     description="Les jours légaux de chaque calendrier, et les ajustements de l'entreprise : jours de remplacement ajoutés, jours fériés travaillés retirés.">
        <nav class="inline-flex items-center gap-0.5 rounded-xl border border-default bg-surface p-1 shadow-xs" aria-label="Navigation entre années">
            {% if year > 1000 %}
                <a href="{{ path('app_holiday_year', {year: year - 1}) }}" data-test="year-prev"
                   class="inline-flex h-8 items-center gap-1 rounded-lg px-2.5 text-sm tabular-nums text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">
                    <twig:ux:icon name="tabler:chevron-left" class="size-4"/>
                    {{ year - 1 }}
                </a>
            {% endif %}
            <a href="{{ path('app_holiday_index') }}" data-test="year-current"
               class="inline-flex h-8 items-center rounded-lg px-3 text-sm font-medium text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">Cette année</a>
            {% if year < 9999 %}
                <a href="{{ path('app_holiday_year', {year: year + 1}) }}" data-test="year-next"
                   class="inline-flex h-8 items-center gap-1 rounded-lg px-2.5 text-sm tabular-nums text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">
                    {{ year + 1 }}
                    <twig:ux:icon name="tabler:chevron-right" class="size-4"/>
                </a>
            {% endif %}
        </nav>
    </twig:PageHeader>

    <twig:Card class="mb-8" data-test="holiday-add">
        <twig:Card:Header>
            <twig:Card:Title as="h2">Ajouter un jour férié</twig:Card:Title>
            <p class="mt-1.5 text-[13px] leading-relaxed text-body">Un jour de remplacement, par exemple. Il ne vaut que pour cette date et ce calendrier.</p>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form, {attr: {'data-test': 'holiday-form'}}) }}
                {{ form_row(form.calendar) }}
                <div class="grid grid-cols-1 gap-x-4 sm:grid-cols-[14rem_minmax(0,1fr)_auto] sm:items-start">
                    {{ form_row(form.day) }}
                    {{ form_row(form.label) }}
                    <twig:Button type="submit" class="sm:mt-[25.5px]" data-test="holiday-submit">
                        <twig:ux:icon name="tabler:plus" class="size-4"/>
                        Ajouter
                    </twig:Button>
                </div>
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {% for item in calendars %}
            <section class="overflow-hidden rounded-card border border-default bg-surface shadow-card" data-test="holiday-calendar" data-calendar="{{ item.calendar.value }}">
                <header class="flex items-center justify-between gap-3 border-b border-default bg-neutral-secondary-soft px-5 py-3.5">
                    <h2 class="text-[15px] font-semibold tracking-tight text-heading">{{ item.calendar.label }}</h2>
                    <span class="rounded-full bg-neutral-tertiary px-2 py-0.5 text-xs tabular-nums text-body">{{ item.lines|length }}</span>
                </header>
                <ul class="divide-y divide-default-subtle text-sm">
                    {% for line in item.lines %}
                        <li class="flex items-center justify-between gap-3 px-5 py-2.5 transition-colors hover:bg-neutral-secondary-soft {{ line.weekend ? 'bg-neutral-secondary-soft/60' : '' }}" data-test="holiday-line"
                            data-day="{{ line.day|date('Y-m-d') }}"
                            data-status="{{ line.added ? 'added' : (line.removed ? 'removed' : 'legal') }}"
                            data-weekend="{{ line.weekend ? 'true' : 'false' }}">
                            <span class="flex min-w-0 items-center gap-3 {{ line.removed ? 'text-body line-through' : 'text-heading' }}">
                                <strong class="w-[4.75rem] shrink-0 text-[13px] font-medium tabular-nums {{ line.added ? 'text-fg-brand' : '' }}">{{ line.day|weekday }} {{ line.day|date('d/m') }}</strong>
                                <span class="truncate" data-test="holiday-label">{{ line.label }}</span>
                            </span>
                            <span class="flex shrink-0 items-center gap-2">
                                {% if line.weekend %}<twig:Badge variant="alternative" border="bordered">Week-end</twig:Badge>{% endif %}
                                {% if line.added %}<twig:Badge variant="brand">Ajouté</twig:Badge>{% endif %}
                                {% if line.removed %}<twig:Badge variant="warning">Retiré</twig:Badge>{% endif %}
                                {% if line.adjustment %}
                                    <form method="post" action="{{ path('app_holiday_cancel', {id: line.adjustment.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('holiday-adjustment-' ~ line.adjustment.id) }}">
                                        <twig:Button type="submit" size="xs" variant="outline" data-test="holiday-cancel">
                                            <twig:ux:icon name="tabler:arrow-back-up" class="size-3.5"/>
                                            Annuler
                                        </twig:Button>
                                    </form>
                                {% elseif not line.weekend %}
                                    <form method="post" action="{{ path('app_holiday_remove') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('holiday-remove') }}">
                                        <input type="hidden" name="calendar" value="{{ item.calendar.value }}">
                                        <input type="hidden" name="day" value="{{ line.day|date('Y-m-d') }}">
                                        <twig:Button type="submit" size="xs" variant="outline-danger" data-test="holiday-remove">Retirer</twig:Button>
                                    </form>
                                {% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    </div>
{% endblock %}
