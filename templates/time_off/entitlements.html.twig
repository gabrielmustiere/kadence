{% extends 'base.html.twig' %}

{% block title %}Compteurs de congés · Kadence{% endblock %}

{% block body %}
    <twig:PageHeader title="Congés" description="Les droits de chacun, déclarés par période : du 1er mai au 30 avril pour les CP, sur l'année civile pour les RTT. Le reliquat ne passe pas tout seul d'une période à l'autre."/>
    {{ include('time_off/_tabs.html.twig') }}

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <nav class="inline-flex items-center gap-0.5 rounded-xl border border-default bg-surface p-1 shadow-xs" aria-label="Type de congé">
            {% for type in ['cp', 'rtt'] %}
                <a href="{{ path('app_time_off_entitlements_period', {type: type, year: period.year}) }}"
                   data-test="entitlements-type-{{ type }}"
                   class="inline-flex h-8 items-center rounded-lg px-3 text-sm font-medium transition-colors {{ type == period.type.value ? 'bg-brand-softer text-fg-brand' : 'text-body hover:bg-neutral-tertiary hover:text-heading' }}">{{ type|upper }}</a>
            {% endfor %}
        </nav>
        <nav class="inline-flex items-center gap-0.5 rounded-xl border border-default bg-surface p-1 shadow-xs" aria-label="Navigation entre périodes">
            <a href="{{ path('app_time_off_entitlements_period', {type: period.type.value, year: period.previous.year}) }}" data-test="entitlements-prev"
               class="inline-flex h-8 items-center gap-1 rounded-lg px-2.5 text-sm tabular-nums text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">
                <twig:ux:icon name="tabler:chevron-left" class="size-4"/>
                {{ period.previous.label }}
            </a>
            <span class="inline-flex h-8 items-center rounded-lg px-3 text-sm font-semibold tabular-nums text-heading" data-test="entitlements-period">{{ period.type.label }} {{ period.label }}</span>
            <a href="{{ path('app_time_off_entitlements_period', {type: period.type.value, year: period.next.year}) }}" data-test="entitlements-next"
               class="inline-flex h-8 items-center gap-1 rounded-lg px-2.5 text-sm tabular-nums text-body transition-colors hover:bg-neutral-tertiary hover:text-heading">
                {{ period.next.label }}
                <twig:ux:icon name="tabler:chevron-right" class="size-4"/>
            </a>
        </nav>
    </div>

    {{ form_start(form, {attr: {'data-test': 'entitlements-form'}}) }}
        {{ form_errors(form) }}
        <div class="overflow-x-auto rounded-card border border-default bg-surface shadow-card">
            <table class="w-full text-sm">
                <thead class="border-b border-default bg-neutral-secondary-soft text-left">
                    <tr>
                        <th scope="col" class="eyebrow px-5 py-3 font-medium text-body-subtle">Personne</th>
                        <th scope="col" class="eyebrow px-5 py-3 text-right font-medium text-body-subtle">Droits (j)</th>
                        <th scope="col" class="eyebrow px-5 py-3 text-right font-medium text-body-subtle">Validés</th>
                        <th scope="col" class="eyebrow px-5 py-3 text-right font-medium text-body-subtle">En attente</th>
                        <th scope="col" class="eyebrow px-5 py-3 text-right font-medium text-body-subtle">Solde</th>
                    </tr>
                </thead>
                <tbody>
                    {% for person in people %}
                        {% set balance = balances[person.id] %}
                        <tr class="border-t border-default-subtle first:border-t-0" data-test="entitlements-row" data-person="{{ person.id }}">
                            <th scope="row" class="px-5 py-2.5 text-left font-medium text-heading">{{ person.firstName }} {{ person.lastName }}</th>
                            <td class="px-5 py-2.5 text-right">
                                {{ form_widget(form.days[person.id]) }}
                                {{ form_errors(form.days[person.id]) }}
                            </td>
                            <td class="px-5 py-2.5 text-right tabular-nums">{{ balance.approvedHalfDays|half_days }}</td>
                            <td class="px-5 py-2.5 text-right tabular-nums">{{ balance.pendingHalfDays|half_days }}</td>
                            <td class="px-5 py-2.5 text-right font-semibold tabular-nums {{ balance.overrun ? 'text-fg-danger-strong' : 'text-heading' }}" data-test="entitlements-remaining">{{ balance.remainingHalfDays|half_days }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="mt-5">
            <twig:Button type="submit" data-test="entitlements-submit">Enregistrer les droits</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
